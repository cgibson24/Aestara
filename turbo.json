{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "generated/**", "openapi.json"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["TEST_ADMIN_DATABASE_URL"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "@aestara/shared-types#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/database/prisma/schema.prisma"],
      "outputs": ["generated/**"]
    },
    "@aestara/database#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!generated/**"],
      "outputs": ["generated/**"]
    },
    "@aestara/database#typecheck": {
      "dependsOn": ["^build", "build"]
    },
    "@aestara/database#test": {
      "dependsOn": ["^build", "build"],
      "env": ["TEST_ADMIN_DATABASE_URL"]
    }
  }
}
