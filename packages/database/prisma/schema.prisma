  isBookable     Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)
  version        Int      @default(1)

  membership          Membership          @relation(fields: [organizationId, userId], references: [organizationId, userId])
  consultations       Consultation[]

  @@unique([organizationId, userId])
}

model StaffProfile {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @db.Uuid
  userId         String   @db.Uuid
  displayName    String
  jobTitle       String?
  department     String?
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)
  version        Int      @default(1)

  membership Membership @relation(fields: [organizationId, userId], references: [organizationId, userId])

  @@unique([organizationId, userId])
}

/// Bible 4.2 minimum patient entity. organizationId is always server-assigned.
model Patient {
  id                    String        @id @default(uuid(7)) @db.Uuid
  organizationId        String        @db.Uuid
  /// Optional or required per deployment policy (OrganizationSetting).
  primaryPracticeId     String?       @db.Uuid
  firstName             String
  middleName            String?
  lastName              String
  preferredName         String?
  dateOfBirth           DateTime      @db.Date
  email                 String?
  phone                 String?
  /// Search keys (ADR-0020), maintained by a database trigger from the name,
  /// email and phone columns; the application never writes them. Name keys are
  /// lower-case, accent-free and alphanumeric only; emailKey is the trimmed,
  /// lower-cased address; phoneKey holds the digits only.
  firstNameKey          String        @default("")
  lastNameKey           String        @default("")
  preferredNameKey      String?
  emailKey              String?
  phoneKey              String?
  /// Internal or externally mapped identifier; unique within the organization.
  mrn                   String?
  externalEmrIdentifier String?
  status                PatientStatus @default(ACTIVE)
  archivedAt            DateTime?     @db.Timestamptz(3)
  archivedById          String?       @db.Uuid
  createdAt             DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime      @updatedAt @db.Timestamptz(3)
  /// NULL only when created by an integration/system actor.
  createdById           String?       @db.Uuid
  updatedById           String?       @db.Uuid
  version               Int           @default(1)

  organization     Organization @relation(fields: [organizationId], references: [id])
  primaryPractice  Practice?    @relation(fields: [organizationId, primaryPracticeId], references: [organizationId, id], onDelete: Restrict)
  createdBy        User?        @relation("PatientCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy        User?        @relation("PatientUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  archivedBy       User?        @relation("PatientArchivedBy", fields: [archivedById], references: [id], onDelete: Restrict)

  contacts           PatientContact[]
  medicalHistory     PatientMedicalHistory[]
  concerns           PatientConcern[]
  consultations      Consultation[]
  photoSessions      PhotoSession[]
  photos             PatientPhoto[]
  photoPermissions   PhotoPermission[]
  mediaReleases      MediaRelease[]
  beforeAfterSets    BeforeAfterSet[]
  aiJobs             AIJob[]
  documents          Document[]

  @@unique([organizationId, id])
  @@unique([organizationId, mrn])
  @@index([organizationId, lastName, firstName])
  @@index([organizationId, dateOfBirth])
  @@index([organizationId, status])
  /// Search indexes (ADR-0020): leakproof comparisons on the keys keep them usable under RLS.
  @@index([organizationId, lastNameKey])
  @@index([organizationId, firstNameKey])
  @@index([organizationId, preferredNameKey])
  @@index([organizationId, emailKey])
  @@index([organizationId, phoneKey])
}

model PatientContact {
  id             String             @id @default(uuid(7)) @db.Uuid
  organizationId String             @db.Uuid
  patientId      String             @db.Uuid
  kind           PatientContactKind
  fullName       String
  relationship   String?
  phone          String?
  email          String?
  isPrimary      Boolean            @default(false)
  notes          String?
  createdById    String?            @db.Uuid
  createdAt      DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @db.Timestamptz(3)
  version        Int                @default(1)

  patient   Patient @relation(fields: [organizationId, patientId], references: [organizationId, id])
  createdBy User?   @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([organizationId, patientId])
}

model PatientMedicalHistory {
  id             String                 @id @default(uuid(7)) @db.Uuid
  organizationId String                 @db.Uuid
  patientId      String                 @db.Uuid
  category       MedicalHistoryCategory
  description    String
  /// Structured detail that varies by category (flexible metadata).
  details        Json?
  onsetDate      DateTime?              @db.Date
  resolvedAt     DateTime?              @db.Date
  source         RecordSource           @default(STAFF)
  recordedById   String?                @db.Uuid
  recordedAt     DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime               @updatedAt @db.Timestamptz(3)
  version        Int                    @default(1)

  patient    Patient @relation(fields: [organizationId, patientId], references: [organizationId, id])
  recordedBy User?   @relation(fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([organizationId, patientId, category])
}

model PatientConcern {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @db.Uuid
  patientId      String    @db.Uuid
  /// Anatomical/aesthetic area, e.g. LIPS, NOSE, ABDOMEN.
  area           String
  description    String
  recordedById   String?   @db.Uuid
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)
  resolvedAt     DateTime? @db.Timestamptz(3)
  version        Int       @default(1)

  patient       Patient               @relation(fields: [organizationId, patientId], references: [organizationId, id])
  recordedBy    User?                 @relation(fields: [recordedById], references: [id], onDelete: Restrict)
  consultations ConsultationConcern[]

  @@unique([organizationId, patientId, id])
}

model Consultation {
  id                    String             @id @default(uuid(7)) @db.Uuid
  organizationId        String             @db.Uuid
  patientId             String             @db.Uuid
  practiceId            String             @db.Uuid
  locationId            String?            @db.Uuid
  primaryProviderUserId String?            @db.Uuid
  status                ConsultationStatus @default(DRAFT)
  reason                String?
  startedAt             DateTime?          @db.Timestamptz(3)
  readyForReviewAt      DateTime?          @db.Timestamptz(3)
  completedAt           DateTime?          @db.Timestamptz(3)
  completedById         String?            @db.Uuid
  cancelledAt           DateTime?          @db.Timestamptz(3)
  cancelledById         String?            @db.Uuid
  cancellationReason    String?
  /// Required for COMPLETED (ADR-0026 K3-04); the three columns are set together.
  releaseDecision       ConsultationReleaseDecision?
  releaseDecidedAt      DateTime?          @db.Timestamptz(3)
  releaseDecidedById    String?            @db.Uuid
  archivedAt            DateTime?          @db.Timestamptz(3)
  createdById           String             @db.Uuid
  createdAt             DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime           @updatedAt @db.Timestamptz(3)
  version               Int                @default(1)

  patient         Patient          @relation(fields: [organizationId, patientId], references: [organizationId, id])
  practice        Practice         @relation(fields: [organizationId, practiceId], references: [organizationId, id])
  location        Location?        @relation(fields: [organizationId, practiceId, locationId], references: [organizationId, practiceId, id], onDelete: Restrict)
  primaryProvider ProviderProfile? @relation(fields: [organizationId, primaryProviderUserId], references: [organizationId, userId], onDelete: Restrict)
  createdBy       User             @relation("ConsultationCreatedBy", fields: [createdById], references: [id])
  completedBy     User?            @relation("ConsultationCompletedBy", fields: [completedById], references: [id], onDelete: Restrict)
  cancelledBy     User?            @relation("ConsultationCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)
  releaseDecidedBy User?           @relation("ConsultationReleaseDecidedBy", fields: [releaseDecidedById], references: [id], onDelete: Restrict)

  concerns           ConsultationConcern[]
  notes              ConsultationNote[]
  photoSessions      PhotoSession[]
  beforeAfterSets    BeforeAfterSet[]
  documents          Document[]

  @@unique([organizationId, id])
  @@unique([organizationId, patientId, id])
  @@index([organizationId, patientId, createdAt])
  @@index([organizationId, practiceId, status])
}

/// Concerns selected for a consultation (Bible 5.1 "Select reason / concerns").
model ConsultationConcern {
  organizationId   String   @db.Uuid
  patientId        String   @db.Uuid
  consultationId   String   @db.Uuid
  patientConcernId String   @db.Uuid
  createdAt        DateTime @default(now()) @db.Timestamptz(3)

  consultation Consultation   @relation(fields: [organizationId, patientId, consultationId], references: [organizationId, patientId, id])
  concern      PatientConcern @relation(fields: [organizationId, patientId, patientConcernId], references: [organizationId, patientId, id])

  @@id([consultationId, patientConcernId])
}

model ConsultationNote {
  /// Client-generated UUIDv7 accepted for offline-drafted notes (spec 8).
  id             String     @id @default(uuid(7)) @db.Uuid
  organizationId String     @db.Uuid
  patientId      String     @db.Uuid
  consultationId String     @db.Uuid
  authorUserId   String     @db.Uuid
  status         NoteStatus @default(DRAFT)
  body           String
  /// An addendum names the FINAL note of the same consultation it corrects (UD-15; ADR-0026 K3-07).
  correctsNoteId String?    @db.Uuid
  finalizedAt    DateTime?  @db.Timestamptz(3)
  createdAt      DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime   @updatedAt @db.Timestamptz(3)
  version        Int        @default(1)

  consultation Consultation      @relation(fields: [organizationId, patientId, consultationId], references: [organizationId, patientId, id])
  author       User              @relation(fields: [authorUserId], references: [id])
  corrects     ConsultationNote? @relation("NoteAddenda", fields: [consultationId, correctsNoteId], references: [consultationId, id], onDelete: Restrict)
  addenda      ConsultationNote[] @relation("NoteAddenda")

  @@unique([consultationId, id])
  @@index([organizationId, consultationId])
}

/// Ledger of every object in private object storage. Objects are write-once:
/// once AVAILABLE, bucket/key/checksum never change (trigger in constraints.sql).
/// Storage keys are never returned by the public API.
model StorageObject {
  id             String              @id @default(uuid(7)) @db.Uuid
  organizationId String              @db.Uuid
  objectClass    StorageObjectClass
  bucket         String
  objectKey      String              @unique
  contentType    String
  byteSize       BigInt?
  /// Hex SHA-256 declared at upload intent and verified on completion.
  sha256         String?
  status         StorageObjectStatus @default(PENDING_UPLOAD)
  scanStatus     MalwareScanStatus   @default(PENDING)
  kmsKeyAlias    String?
  uploadedById   String?             @db.Uuid
  createdAt      DateTime            @default(now()) @db.Timestamptz(3)
  verifiedAt     DateTime?           @db.Timestamptz(3)
  purgedAt       DateTime?           @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id])
  uploadedBy   User?        @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  originalOf              PatientPhoto?
  derivativeOf            PhotoDerivative?
  documentVersion         DocumentVersion?

  @@unique([organizationId, id])
  @@index([organizationId, objectClass, createdAt])
}

/// Every protocol row is tenant-owned. The Bible 6.2 standard protocols are
/// provided to organizations in Layer 2 (spec §6.3), not at creation. Views are frozen once the
/// protocol is ACTIVE; changes create a new protocol that supersedes it.
model PhotographyProtocol {
  id             String         @id @default(uuid(7)) @db.Uuid
  organizationId String         @db.Uuid
  practiceId     String?        @db.Uuid
  name           String
  bodyRegion     BodyRegion
  description    String?
  status         ProtocolStatus @default(DRAFT)
  supersedesId   String?        @db.Uuid
  createdById    String?        @db.Uuid
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(3)
  version        Int            @default(1)

  organization Organization         @relation(fields: [organizationId], references: [id])
  practice     Practice?            @relation(fields: [organizationId, practiceId], references: [organizationId, id], onDelete: Restrict)
  supersedes   PhotographyProtocol? @relation("ProtocolSupersession", fields: [organizationId, supersedesId], references: [organizationId, id], onDelete: Restrict)
  supersededBy PhotographyProtocol? @relation("ProtocolSupersession")
  createdBy    User?                @relation(fields: [createdById], references: [id], onDelete: Restrict)

  views         PhotographyProtocolView[]
  photoSessions PhotoSession[]

  @@unique([organizationId, id])
  @@unique([organizationId, supersedesId])
  @@index([organizationId, status])
}

model PhotographyProtocolView {
  id                  String   @id @default(uuid(7)) @db.Uuid
  organizationId      String   @db.Uuid
  protocolId          String   @db.Uuid
  /// Stable key, e.g. FRONT, LEFT_45, RIGHT_45, LEFT_PROFILE, BACK.
  viewKey             String
  name                String
  sortOrder           Int
  isRequired          Boolean
  captureInstructions String?
  /// Target pose/framing tolerances used by live guidance (flexible metadata).
  poseTarget          Json?
  createdAt           DateTime @default(now()) @db.Timestamptz(3)

  protocol PhotographyProtocol @relation(fields: [organizationId, protocolId], references: [organizationId, id])
  photos   PatientPhoto[]

  @@unique([organizationId, id])
  @@unique([protocolId, viewKey])
}

model PhotoSession {
  /// Client-generated UUIDv7 accepted for offline capture (spec 8).
  id               String             @id @default(uuid(7)) @db.Uuid
  organizationId   String             @db.Uuid
  patientId        String             @db.Uuid
  protocolId       String             @db.Uuid
  source           PhotoSource
  status           PhotoSessionStatus @default(IN_PROGRESS)
  /// Required except for IMPORT sessions (CHECK in constraints.sql, Bible 6.1).
  capturedByUserId String?            @db.Uuid
  consultationId   String?            @db.Uuid
  practiceId       String?            @db.Uuid
  locationId       String?            @db.Uuid
  startedAt        DateTime           @db.Timestamptz(3)
  completedAt      DateTime?          @db.Timestamptz(3)
  createdAt        DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime           @updatedAt @db.Timestamptz(3)

  patient      Patient             @relation(fields: [organizationId, patientId], references: [organizationId, id])
  protocol     PhotographyProtocol @relation(fields: [organizationId, protocolId], references: [organizationId, id])
  capturedBy   User?               @relation(fields: [capturedByUserId], references: [id], onDelete: Restrict)
  consultation Consultation?       @relation(fields: [organizationId, patientId, consultationId], references: [organizationId, patientId, id], onDelete: Restrict)
  practice     Practice?           @relation(fields: [organizationId, practiceId], references: [organizationId, id], onDelete: Restrict)
  location     Location?           @relation(fields: [organizationId, practiceId, locationId], references: [organizationId, practiceId, id], onDelete: Restrict)

  photos      PatientPhoto[]
  permissions PhotoPermission[]

  @@unique([organizationId, id])
  @@unique([organizationId, patientId, id])
  @@index([organizationId, patientId, startedAt])
}

/// The clinical photo record. originalObjectId points at the immutable
/// ORIGINAL; it can never be changed (trigger in constraints.sql).
model PatientPhoto {
  /// Client-generated UUIDv7 accepted for offline capture (spec 8).
  id                 String      @id @default(uuid(7)) @db.Uuid
  organizationId     String      @db.Uuid
  patientId          String      @db.Uuid
  photoSessionId     String?     @db.Uuid
  protocolViewId     String?     @db.Uuid
  viewKey            String?
  source             PhotoSource
  status             PhotoStatus @default(UPLOAD_PENDING)
  originalObjectId   String      @db.Uuid
  capturedByUserId   String?     @db.Uuid
  capturedAt         DateTime    @db.Timestamptz(3)
  widthPx            Int?
  heightPx           Int?
  /// Device/lens/exposure/pose estimates (flexible metadata; no free text).
  captureMetadata    Json?
  /// Post-capture quality check results (flexible metadata).
  qualityChecks      Json?
  /// Ghost-alignment photographic position-match score (0..1).
  /// Never labelled medical accuracy (Bible 6.5).
  positionMatchScore Decimal?    @db.Decimal(5, 4)
  reviewedById       String?     @db.Uuid
  reviewedAt         DateTime?   @db.Timestamptz(3)
  reviewNote         String?
  archivedAt         DateTime?   @db.Timestamptz(3)
  createdAt          DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime    @updatedAt @db.Timestamptz(3)

  patient      Patient                  @relation(fields: [organizationId, patientId], references: [organizationId, id])
  photoSession PhotoSession?            @relation(fields: [organizationId, patientId, photoSessionId], references: [organizationId, patientId, id], onDelete: Restrict)
  protocolView PhotographyProtocolView? @relation(fields: [organizationId, protocolViewId], references: [organizationId, id], onDelete: Restrict)
  original     StorageObject            @relation(fields: [organizationId, originalObjectId], references: [organizationId, id])
  capturedBy   User?                    @relation("PhotoCapturedBy", fields: [capturedByUserId], references: [id], onDelete: Restrict)
  reviewedBy   User?                    @relation("PhotoReviewedBy", fields: [reviewedById], references: [id], onDelete: Restrict)

  derivatives         PhotoDerivative[]
  annotations         PhotoAnnotation[]
  tags                PhotoTag[]
  permissions         PhotoPermission[]
  mediaReleases       MediaRelease[]
  beforeSets          BeforeAfterSet[]          @relation("BeforePhoto")
  afterSets           BeforeAfterSet[]          @relation("AfterPhoto")

  @@unique([organizationId, id])
  @@unique([organizationId, patientId, id])
  @@unique([organizationId, originalObjectId])
  @@index([organizationId, patientId, capturedAt])
  @@index([organizationId, patientId, viewKey])
}

/// Every derivative references its source photo and generation metadata
/// (Bible 6.6). Derivatives are immutable; regeneration creates a new row.
model PhotoDerivative {
  id                 String         @id @default(uuid(7)) @db.Uuid
  organizationId     String         @db.Uuid
  patientId          String         @db.Uuid
  sourcePhotoId      String         @db.Uuid
  kind               DerivativeKind
  storageObjectId    String         @db.Uuid
  /// Generator name/version, parameters, transforms (flexible metadata).
  generationMetadata Json
  generatedByJobId   String?        @db.Uuid
  beforeAfterSetId   String?        @db.Uuid
  annotationId       String?        @db.Uuid
  createdById        String?        @db.Uuid
  createdAt          DateTime       @default(now()) @db.Timestamptz(3)

  sourcePhoto    PatientPhoto     @relation(fields: [organizationId, patientId, sourcePhotoId], references: [organizationId, patientId, id])
  storageObject  StorageObject    @relation(fields: [organizationId, storageObjectId], references: [organizationId, id])
  generatedByJob AIJob?           @relation(fields: [organizationId, generatedByJobId], references: [organizationId, id], onDelete: Restrict)
  beforeAfterSet BeforeAfterSet?  @relation(fields: [organizationId, patientId, beforeAfterSetId], references: [organizationId, patientId, id], onDelete: Restrict)
  annotation     PhotoAnnotation? @relation(fields: [organizationId, patientId, annotationId], references: [organizationId, patientId, id], onDelete: Restrict)
  createdBy      User?            @relation(fields: [createdById], references: [id], onDelete: Restrict)

  mediaReleases      MediaRelease[]

  @@unique([organizationId, id])
  @@unique([organizationId, patientId, id])
  @@unique([organizationId, storageObjectId])
  @@index([sourcePhotoId, kind])
}

/// Vector annotation layer (never burned into the original). Coordinates are
/// normalized 0..1 relative to the original image.
model PhotoAnnotation {
  /// Client-generated UUIDv7 accepted for offline annotation (spec 8).
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @db.Uuid
  patientId      String    @db.Uuid
  photoId        String    @db.Uuid
  authorUserId   String    @db.Uuid
  schemaVersion  Int       @default(1)
  layer          Json
  label          String?
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt      DateTime? @db.Timestamptz(3)
  version        Int       @default(1)

  photo                PatientPhoto      @relation(fields: [organizationId, patientId, photoId], references: [organizationId, patientId, id])
  author               User              @relation(fields: [authorUserId], references: [id])
  renderedDerivatives  PhotoDerivative[]

  @@unique([organizationId, patientId, id])
  @@index([photoId])
}

model PhotoTag {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @db.Uuid
  patientId      String   @db.Uuid
  photoId        String   @db.Uuid
  tag            String
  createdById    String?  @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  photo     PatientPhoto @relation(fields: [organizationId, patientId, photoId], references: [organizationId, patientId, id])
  createdBy User?        @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([photoId, tag])
  @@index([organizationId, tag])
}

/// Versioned, append-only media permission (Bible 7). Each change inserts a new
/// row and stamps supersededAt on the previous one; exactly one current row per
/// (patient, category, scope target) is enforced in constraints.sql.
/// No category implies another.
model PhotoPermission {
  id                          String                  @id @default(uuid(7)) @db.Uuid
  organizationId              String                  @db.Uuid
  patientId                   String                  @db.Uuid
  category                    MediaPermissionCategory
  scope                       PermissionScope
  photoSessionId              String?                 @db.Uuid
  photoId                     String?                 @db.Uuid
  state                       PhotoPermissionState
  versionNumber               Int
  previousVersionId           String?                 @db.Uuid
  effectiveAt                 DateTime                @db.Timestamptz(3)
  expiresAt                   DateTime?               @db.Timestamptz(3)
  evidence                    PermissionEvidence?
  reason                      String?
  recordedById                String?                 @db.Uuid
  createdAt                   DateTime                @default(now()) @db.Timestamptz(3)
  supersededAt                DateTime?               @db.Timestamptz(3)

  patient            Patient            @relation(fields: [organizationId, patientId], references: [organizationId, id])
  photoSession       PhotoSession?      @relation(fields: [organizationId, patientId, photoSessionId], references: [organizationId, patientId, id], onDelete: Restrict)
  photo              PatientPhoto?      @relation(fields: [organizationId, patientId, photoId], references: [organizationId, patientId, id], onDelete: Restrict)
  previousVersion    PhotoPermission?   @relation("PhotoPermissionHistory", fields: [organizationId, patientId, previousVersionId], references: [organizationId, patientId, id], onDelete: Restrict)
  nextVersion        PhotoPermission?   @relation("PhotoPermissionHistory")
  recordedBy         User?              @relation(fields: [recordedById], references: [id], onDelete: Restrict)

  releasePins        MediaReleasePermission[]

  @@unique([organizationId, patientId, id])
  @@unique([organizationId, patientId, previousVersionId])
  @@index([organizationId, patientId, category])
}

/// Record that a specific asset was released/exported for a purpose. Every
/// PhotoPermission version relied on at that moment is pinned in
/// MediaReleasePermission (a before/after or simulation can depend on several).
/// A release without at least one pinned permission is rejected at commit.
model MediaRelease {
  id               String                  @id @default(uuid(7)) @db.Uuid
  organizationId   String                  @db.Uuid
  patientId        String                  @db.Uuid
  purpose          MediaPermissionCategory
  photoId          String?                 @db.Uuid
  derivativeId     String?                 @db.Uuid
  beforeAfterSetId String?                 @db.Uuid
  releasedById     String                  @db.Uuid
  releasedAt       DateTime                @default(now()) @db.Timestamptz(3)
  revokedAt        DateTime?               @db.Timestamptz(3)
  revokedById      String?                 @db.Uuid
  revocationReason String?

  patient        Patient          @relation(fields: [organizationId, patientId], references: [organizationId, id])
  photo          PatientPhoto?    @relation(fields: [organizationId, patientId, photoId], references: [organizationId, patientId, id], onDelete: Restrict)
  derivative     PhotoDerivative? @relation(fields: [organizationId, patientId, derivativeId], references: [organizationId, patientId, id], onDelete: Restrict)
  beforeAfterSet BeforeAfterSet?  @relation(fields: [organizationId, patientId, beforeAfterSetId], references: [organizationId, patientId, id], onDelete: Restrict)
  releasedBy     User             @relation("MediaReleaseReleasedBy", fields: [releasedById], references: [id])
  revokedBy      User?            @relation("MediaReleaseRevokedBy", fields: [revokedById], references: [id], onDelete: Restrict)

  permissions        MediaReleasePermission[]

  @@unique([organizationId, patientId, id])
  @@index([organizationId, patientId, purpose])
}

/// The exact permission versions a MediaRelease relied on. Append-only.
model MediaReleasePermission {
  organizationId String @db.Uuid
  patientId      String @db.Uuid
  mediaReleaseId String @db.Uuid
  permissionId   String @db.Uuid

  mediaRelease MediaRelease    @relation(fields: [organizationId, patientId, mediaReleaseId], references: [organizationId, patientId, id])
  permission   PhotoPermission @relation(fields: [organizationId, patientId, permissionId], references: [organizationId, patientId, id])

  @@id([mediaReleaseId, permissionId])
  @@index([permissionId])
}

/// Both photos are constrained by composite FKs to the SAME organization and
/// the SAME patient (Bible 8.1, acceptance 34.1 #12-13).
model BeforeAfterSet {
  id                    String           @id @default(uuid(7)) @db.Uuid
  organizationId        String           @db.Uuid
  patientId             String           @db.Uuid
  beforePhotoId         String           @db.Uuid
  afterPhotoId          String           @db.Uuid
  consultationId        String?          @db.Uuid
  viewKey               String?
  title                 String?
  registrationMode      RegistrationMode @default(NONE)
  /// 2D transform (normalized coordinates) applied at display time only.
  registrationTransform Json?
  registrationJobId     String?          @db.Uuid
  createdById           String           @db.Uuid
  createdAt             DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime         @updatedAt @db.Timestamptz(3)
  version               Int              @default(1)

  patient         Patient       @relation(fields: [organizationId, patientId], references: [organizationId, id])
  beforePhoto     PatientPhoto  @relation("BeforePhoto", fields: [organizationId, patientId, beforePhotoId], references: [organizationId, patientId, id])
  afterPhoto      PatientPhoto  @relation("AfterPhoto", fields: [organizationId, patientId, afterPhotoId], references: [organizationId, patientId, id])
  consultation    Consultation? @relation(fields: [organizationId, patientId, consultationId], references: [organizationId, patientId, id], onDelete: Restrict)
  registrationJob AIJob?        @relation(fields: [organizationId, registrationJobId], references: [organizationId, id], onDelete: Restrict)
  createdBy       User          @relation(fields: [createdById], references: [id])

  derivatives         PhotoDerivative[]
  mediaReleases       MediaRelease[]

  @@unique([organizationId, id])
  @@unique([organizationId, patientId, id])
}

/// Generic job record (spec 5.8): image derivatives from Layer 2 (ADR-0023 K2-06),
/// before/after registration from Layer 3, AI jobs from Layer 7 (model FK).
model AIJob {
  id             String      @id @default(uuid(7)) @db.Uuid
  organizationId String      @db.Uuid
  patientId      String?     @db.Uuid
  jobType        AIJobType
  status         AIJobStatus @default(QUEUED)
  /// Prevents duplicate AI jobs on retry (Bible 20.3 / 23.3).
  idempotencyKey String
  requestedById  String?     @db.Uuid
  attempt        Int         @default(0)
  /// Identifiers and parameters only; never image bytes or free-text PHI.
  inputSummary   Json?
  /// Scores/metrics only; never image bytes or free-text PHI.
  resultSummary  Json?
  errorCode      String?
  queuedAt       DateTime    @default(now()) @db.Timestamptz(3)
  startedAt      DateTime?   @db.Timestamptz(3)
  finishedAt     DateTime?   @db.Timestamptz(3)
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @db.Timestamptz(3)

  organization Organization    @relation(fields: [organizationId], references: [id])
  patient      Patient?        @relation(fields: [organizationId, patientId], references: [organizationId, id], onDelete: Restrict)
  requestedBy  User?           @relation(fields: [requestedById], references: [id], onDelete: Restrict)

  derivatives        PhotoDerivative[]
  registrations      BeforeAfterSet[]

  @@unique([organizationId, id])
  @@unique([organizationId, idempotencyKey])
  @@index([status, queuedAt])
}

model Document {
  id                  String         @id @default(uuid(7)) @db.Uuid
  organizationId      String         @db.Uuid
  patientId           String         @db.Uuid
  type                DocumentType
  title               String
  consultationId      String?        @db.Uuid
  status              DocumentStatus @default(ACTIVE)
  /// Patient-app visibility requires an explicit release (Bible 13.2).
  releasedToPatientAt DateTime?      @db.Timestamptz(3)
  releasedById        String?        @db.Uuid
  createdById         String?        @db.Uuid
  createdAt           DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime       @updatedAt @db.Timestamptz(3)

  patient      Patient       @relation(fields: [organizationId, patientId], references: [organizationId, id])
  consultation Consultation? @relation(fields: [organizationId, patientId, consultationId], references: [organizationId, patientId, id], onDelete: Restrict)
  releasedBy   User?         @relation("DocumentReleasedBy", fields: [releasedById], references: [id], onDelete: Restrict)
  createdBy    User?         @relation("DocumentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  versions  DocumentVersion[]

  @@unique([organizationId, id])
  @@unique([organizationId, patientId, id])
  @@index([organizationId, patientId, type])
}

/// Immutable file version (trigger). New content = new version.
model DocumentVersion {
  id              String   @id @default(uuid(7)) @db.Uuid
  organizationId  String   @db.Uuid
  patientId       String   @db.Uuid
  documentId      String   @db.Uuid
  versionNumber   Int
  storageObjectId String   @db.Uuid
  sha256          String
  changeNote      String?
  createdById     String?  @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  document      Document      @relation(fields: [organizationId, patientId, documentId], references: [organizationId, patientId, id])
  storageObject StorageObject @relation(fields: [organizationId, storageObjectId], references: [organizationId, id])
  createdBy     User?         @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([documentId, versionNumber])
  @@unique([organizationId, patientId, id])
  @@unique([organizationId, storageObjectId])
}

/// Append-only audit trail (Bible 22). Deliberately has NO foreign keys so it
/// can be partitioned, exported to WORM storage and outlive referenced rows.
/// UPDATE/DELETE are blocked by trigger and by database grants.
/// metadata must never embed clinical content (Bible 22.2).
model AuditEvent {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String?      @db.Uuid
  actorType      ActorType
  actorUserId    String?      @db.Uuid
  actorServiceId String?
  action         AuditAction
  outcome        AuditOutcome @default(SUCCESS)
  resourceType   String
  resourceId     String?      @db.Uuid
  /// Enables per-patient access reports; an identifier, not clinical content.
  patientId      String?      @db.Uuid
  requestId      String
  sessionId      String?      @db.Uuid
  deviceId       String?      @db.Uuid
  ipAddress      String?      @db.Inet
  userAgent      String?
  metadata       Json?
  occurredAt     DateTime     @default(now()) @db.Timestamptz(3)

  @@index([organizationId, occurredAt])
  @@index([organizationId, patientId, occurredAt])
  @@index([organizationId, resourceType, resourceId])
  @@index([actorUserId, occurredAt])
  @@index([requestId])
}

/// Transactional outbox: domain events are written in the same transaction as
/// the state change, then relayed to SQS/EventBridge. Payload = identifiers only.
model OutboxEvent {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String?   @db.Uuid
  eventType      String
  aggregateType  String
  aggregateId    String    @db.Uuid
  payload        Json
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  availableAt    DateTime  @default(now()) @db.Timestamptz(3)
  publishedAt    DateTime? @db.Timestamptz(3)
  attempts       Int       @default(0)
  lastErrorCode  String?

  @@index([publishedAt, availableAt])
}

/// Replay protection for retry-sensitive mutations (Bible 20.3). Stores the
/// outcome reference, not the response body, to avoid duplicating PHI.
model IdempotencyKey {
  id             String           @id @default(uuid(7)) @db.Uuid
  /// "user:<uuid>" or "service:<name>"
  actorKey       String
  key            String
  organizationId String?          @db.Uuid
  method         String
  routeTemplate  String
  /// SHA-256 of the canonical request; a reused key with a different hash is rejected.
  requestHash    String
  state          IdempotencyState @default(IN_PROGRESS)
  responseStatus Int?
  resourceType   String?
  resourceId     String?          @db.Uuid
  errorCode      String?
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  expiresAt      DateTime         @db.Timestamptz(3)

  @@unique([actorKey, key])
  @@index([expiresAt])
}

/// Controlled rollout only; flags never bypass authorization (Bible 26).
/// organizationId/practiceId NULL = platform default. Uniqueness of
/// (key, organizationId, practiceId) incl. NULLs is enforced in SQL.
model FeatureFlag {
  id             String   @id @default(uuid(7)) @db.Uuid
  key            String
  organizationId String?  @db.Uuid
  practiceId     String?  @db.Uuid
  enabled        Boolean
  description    String?
  updatedById    String?  @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  practice     Practice?     @relation(fields: [organizationId, practiceId], references: [organizationId, id], onDelete: Restrict)
  updatedBy    User?         @relation(fields: [updatedById], references: [id], onDelete: Restrict)

  @@index([key])
}

/// Typed key/value settings. Keys and value schemas are registered in code
/// (packages/shared-types); unknown keys are rejected.
model PracticeSetting {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @db.Uuid
  practiceId     String   @db.Uuid
  key            String
  value          Json
  updatedById    String?  @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)
  version        Int      @default(1)

  practice  Practice @relation(fields: [organizationId, practiceId], references: [organizationId, id])
  updatedBy User?    @relation(fields: [updatedById], references: [id], onDelete: Restrict)

  @@unique([practiceId, key])
}

model OrganizationSetting {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @db.Uuid
  key            String
  value          Json
  updatedById    String?  @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)
  version        Int      @default(1)

  organization Organization @relation(fields: [organizationId], references: [id])
  updatedBy    User?        @relation(fields: [updatedById], references: [id], onDelete: Restrict)

  @@unique([organizationId, key])
}

/// Policy-driven retention (Bible 22.3). No universal period is hard-coded:
/// with no policy row for a category, nothing is automatically deleted.
model RetentionPolicy {
  id             String                  @id @default(uuid(7)) @db.Uuid
  organizationId String                  @db.Uuid
  recordCategory RetentionRecordCategory
  /// NULL = retain indefinitely.
  retentionDays  Int?
  action         RetentionAction
  /// Policy / legal basis reference supplied by the customer.
  basis          String
  effectiveFrom  DateTime                @db.Timestamptz(3)
  createdById    String                  @db.Uuid
  createdAt      DateTime                @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id])
  createdBy    User         @relation(fields: [createdById], references: [id])

  @@unique([organizationId, recordCategory, effectiveFrom])
}
