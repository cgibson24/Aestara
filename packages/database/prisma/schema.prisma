/// Platform-level identity. NOT tenant-owned: one workforce user may hold
/// memberships in several organizations. Tenant access always flows through
/// Membership + UserRole (staff) or PatientUserLink (patients), never User alone.
model User {
  id                 String     @id @default(uuid(7)) @db.Uuid
  kind               UserKind
  /// Stored normalized (trimmed, lower-cased). Unique per kind.
  email              String
  emailVerifiedAt    DateTime?  @db.Timestamptz(3)
  phone              String?
  displayName        String?
  status             UserStatus @default(INVITED)
  /// Reserved for future enterprise SSO federation (identity is first-party, D-02).
  externalIdpSubject String?    @unique
  lastLoginAt        DateTime?  @db.Timestamptz(3)
  createdAt          DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime   @updatedAt @db.Timestamptz(3)
  version            Int        @default(1)

  // --- back-relations (required by Prisma; not columns) ---
  memberships                 Membership[]            @relation("MembershipUser")
  membershipsDisabled         Membership[]            @relation("MembershipDisabledBy")
  roleAssignments             UserRole[]              @relation("UserRoleUser")
  roleAssignmentsGranted      UserRole[]              @relation("UserRoleAssignedBy")
  roleAssignmentsRevoked      UserRole[]              @relation("UserRoleRevokedBy")
  credentials                 UserCredential[]
  devices                     Device[]                @relation("DeviceUser")
  devicesRevoked              Device[]                @relation("DeviceRevokedBy")
  sessions                    Session[]               @relation("SessionUser")
  sessionsRevoked             Session[]               @relation("SessionRevokedBy")
  loginEvents                 LoginEvent[]
  tokens                      UserToken[]             @relation("UserTokenUser")
  tokensCreated               UserToken[]             @relation("UserTokenCreatedBy")
  patientsCreated             Patient[]               @relation("PatientCreatedBy")
  patientsUpdated             Patient[]               @relation("PatientUpdatedBy")
  patientsArchived            Patient[]               @relation("PatientArchivedBy")
  patientContactsCreated      PatientContact[]
  medicalHistoryRecorded      PatientMedicalHistory[]
  concernsRecorded            PatientConcern[]
  consultationsCreated        Consultation[]          @relation("ConsultationCreatedBy")
  consultationsCompleted      Consultation[]          @relation("ConsultationCompletedBy")
  consultationsCancelled      Consultation[]          @relation("ConsultationCancelledBy")
  consultationReleaseDecisions Consultation[]         @relation("ConsultationReleaseDecidedBy")
  consultationNotes           ConsultationNote[]
  proceduresCreated           Procedure[]             @relation("ProcedureCreatedBy")
  proceduresCancelled         Procedure[]             @relation("ProcedureCancelledBy")
  treatmentPlansCreated       TreatmentPlan[]         @relation("TreatmentPlanCreatedBy")
  treatmentPlansCancelled     TreatmentPlan[]         @relation("TreatmentPlanCancelledBy")
  protocolsCreated            PhotographyProtocol[]
  photoSessionsCaptured       PhotoSession[]
  photosCaptured              PatientPhoto[]          @relation("PhotoCapturedBy")
  photosReviewed              PatientPhoto[]          @relation("PhotoReviewedBy")
  derivativesCreated          PhotoDerivative[]
  annotations                 PhotoAnnotation[]
  photoTags                   PhotoTag[]
  photoPermissionsRecorded    PhotoPermission[]
  mediaReleasesReleased       MediaRelease[]          @relation("MediaReleaseReleasedBy")
  mediaReleasesRevoked        MediaRelease[]          @relation("MediaReleaseRevokedBy")
  beforeAfterSets             BeforeAfterSet[]
  storageObjectsUploaded      StorageObject[]
  aiJobsRequested             AIJob[]
  consentTemplatesCreated     ConsentTemplate[]
  consentVersionsCreated      ConsentTemplateVersion[] @relation("ConsentVersionCreatedBy")
  consentVersionsPublished    ConsentTemplateVersion[] @relation("ConsentVersionPublishedBy")
  consentsAssigned            ConsentAssignment[]     @relation("ConsentAssignedBy")
  consentsVoided              ConsentAssignment[]     @relation("ConsentVoidedBy")
  consentSignatures           ConsentSignature[]
  patientHandoffsOpened       PatientHandoff[]
  documentsCreated            Document[]              @relation("DocumentCreatedBy")
  documentsReleased           Document[]              @relation("DocumentReleasedBy")
  documentVersionsCreated     DocumentVersion[]
  educationContentCreated     EducationContent[]
  educationVersionsPublished  EducationContentVersion[]
  contentAssigned             ContentAssignment[]
  instructionsAssigned        PatientInstruction[]    @relation("InstructionAssignedBy")
  instructionsCompleted       PatientInstruction[]    @relation("InstructionCompletedBy")
  estimatesCreated            Estimate[]              @relation("EstimateCreatedBy")
  estimatesIssued             Estimate[]              @relation("EstimateIssuedBy")
  estimatesVoided             Estimate[]              @relation("EstimateVoidedBy")
  featureFlagsUpdated         FeatureFlag[]
