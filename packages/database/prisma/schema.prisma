/// A workforce user's membership in one organization. user.disable acts here
/// (per-organization), not on the platform-level User.
model Membership {
  id             String           @id @default(uuid(7)) @db.Uuid
  organizationId String           @db.Uuid
  userId         String           @db.Uuid
  status         MembershipStatus @default(INVITED)
  invitedAt      DateTime?        @db.Timestamptz(3)
  activatedAt    DateTime?        @db.Timestamptz(3)
  disabledAt     DateTime?        @db.Timestamptz(3)
  disabledById   String?          @db.Uuid
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(3)
  version        Int              @default(1)

  organization    Organization     @relation(fields: [organizationId], references: [id])
  user            User             @relation("MembershipUser", fields: [userId], references: [id])
  disabledBy      User?            @relation("MembershipDisabledBy", fields: [disabledById], references: [id], onDelete: Restrict)
  roleAssignments UserRole[]
  providerProfile ProviderProfile?
  staffProfile    StaffProfile?

  @@unique([organizationId, userId])
  @@index([userId])
}

/// organizationId NULL = platform-defined system role (the Bible 3.2 roles).
/// Non-null = organization custom role (creation of custom roles is UD-07).
model Role {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String?  @db.Uuid
  /// Stable machine key, e.g. SURGEON_PHYSICIAN, FRONT_DESK.
  key            String
  name           String
  description    String?
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  organization Organization?    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  permissions  RolePermission[]
  assignments  UserRole[]

  @@unique([organizationId, key])
}

/// Platform catalog of permission keys (Bible 3.3). Not tenant-owned.
model Permission {
  id          String   @id @default(uuid(7)) @db.Uuid
  /// e.g. patient.read, simulation.approve
  key         String   @unique
  description String
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  roles RolePermission[]
}

model RolePermission {
  roleId       String   @db.Uuid
