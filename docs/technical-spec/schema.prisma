/// Ledger of every object in private object storage. Objects are write-once:
/// once AVAILABLE, bucket/key/checksum never change (trigger in constraints.sql).
/// Storage keys are never returned by the public API.
model StorageObject {
  id             String              @id @default(uuid(7)) @db.Uuid
  organizationId String              @db.Uuid
  objectClass    StorageObjectClass
  bucket         String
  objectKey      String              @unique
  contentType    String
  byteSize       BigInt?
  /// Hex SHA-256 declared at upload intent and verified on completion.
  sha256         String?
  status         StorageObjectStatus @default(PENDING_UPLOAD)
  scanStatus     MalwareScanStatus   @default(PENDING)
  kmsKeyAlias    String?
  uploadedById   String?             @db.Uuid
  createdAt      DateTime            @default(now()) @db.Timestamptz(3)
  verifiedAt     DateTime?           @db.Timestamptz(3)
  purgedAt       DateTime?           @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id])
  uploadedBy   User?        @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  originalOf              PatientPhoto?
  derivativeOf            PhotoDerivative?
  simulationMaskOf        SimulationVersion?
  documentVersion         DocumentVersion?
  consentSignature        ConsentSignature?
  messageAttachment       MessageAttachment?
  educationContentVersion EducationContentVersion[]
  dataExportJob           DataExportJob?
  deadLetter              IntegrationDeadLetter?

  @@unique([organizationId, id])
  @@index([organizationId, objectClass, createdAt])
}

/// Every protocol row is tenant-owned. The Bible 6.2 standard protocols are
/// provided to organizations in Layer 2 (spec §6.3), not at creation. Views are frozen once the
/// protocol is ACTIVE; changes create a new protocol that supersedes it.
model PhotographyProtocol {
  id             String         @id @default(uuid(7)) @db.Uuid
  organizationId String         @db.Uuid
  practiceId     String?        @db.Uuid
  name           String
  bodyRegion     BodyRegion
  description    String?
  status         ProtocolStatus @default(DRAFT)
  supersedesId   String?        @db.Uuid
  createdById    String?        @db.Uuid
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(3)
  version        Int            @default(1)

  organization Organization         @relation(fields: [organizationId], references: [id])
  practice     Practice?            @relation(fields: [organizationId, practiceId], references: [organizationId, id], onDelete: Restrict)
  supersedes   PhotographyProtocol? @relation("ProtocolSupersession", fields: [organizationId, supersedesId], references: [organizationId, id], onDelete: Restrict)
  supersededBy PhotographyProtocol? @relation("ProtocolSupersession")
  createdBy    User?                @relation(fields: [createdById], references: [id], onDelete: Restrict)

  views         PhotographyProtocolView[]
  photoSessions PhotoSession[]
  photoRequests PhotoRequest[]

  @@unique([organizationId, id])
  @@unique([organizationId, supersedesId])
  @@index([organizationId, status])
}

model PhotographyProtocolView {
  id                  String   @id @default(uuid(7)) @db.Uuid
  organizationId      String   @db.Uuid
  protocolId          String   @db.Uuid
  /// Stable key, e.g. FRONT, LEFT_45, RIGHT_45, LEFT_PROFILE, BACK.
  viewKey             String
  name                String
  sortOrder           Int
  isRequired          Boolean
  captureInstructions String?
  /// Target pose/framing tolerances used by live guidance (flexible metadata).
  poseTarget          Json?
  createdAt           DateTime @default(now()) @db.Timestamptz(3)

  protocol PhotographyProtocol @relation(fields: [organizationId, protocolId], references: [organizationId, id])
  photos   PatientPhoto[]

  @@unique([organizationId, id])
  @@unique([protocolId, viewKey])
}

model PhotoSession {
  /// Client-generated UUIDv7 accepted for offline capture (spec 8).
  id               String             @id @default(uuid(7)) @db.Uuid
  organizationId   String             @db.Uuid
  patientId        String             @db.Uuid
  protocolId       String             @db.Uuid
  source           PhotoSource
  status           PhotoSessionStatus @default(IN_PROGRESS)
  /// Required except for IMPORT sessions (CHECK in constraints.sql, Bible 6.1).
  capturedByUserId String?            @db.Uuid
  consultationId   String?            @db.Uuid
  procedureId      String?            @db.Uuid
  practiceId       String?            @db.Uuid
  locationId       String?            @db.Uuid
  photoRequestId   String?            @db.Uuid
  startedAt        DateTime           @db.Timestamptz(3)
  completedAt      DateTime?          @db.Timestamptz(3)
  createdAt        DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime           @updatedAt @db.Timestamptz(3)

  patient      Patient             @relation(fields: [organizationId, patientId], references: [organizationId, id])
  protocol     PhotographyProtocol @relation(fields: [organizationId, protocolId], references: [organizationId, id])
  capturedBy   User?               @relation(fields: [capturedByUserId], references: [id], onDelete: Restrict)
  consultation Consultation?       @relation(fields: [organizationId, patientId, consultationId], references: [organizationId, patientId, id], onDelete: Restrict)
  procedure    Procedure?          @relation(fields: [organizationId, patientId, procedureId], references: [organizationId, patientId, id], onDelete: Restrict)
  practice     Practice?           @relation(fields: [organizationId, practiceId], references: [organizationId, id], onDelete: Restrict)
  location     Location?           @relation(fields: [organizationId, practiceId, locationId], references: [organizationId, practiceId, id], onDelete: Restrict)
  photoRequest PhotoRequest?       @relation(fields: [organizationId, patientId, photoRequestId], references: [organizationId, patientId, id], onDelete: Restrict)

  photos      PatientPhoto[]
  permissions PhotoPermission[]

  @@unique([organizationId, id])
  @@unique([organizationId, patientId, id])
  @@index([organizationId, patientId, startedAt])
}

/// The clinical photo record. originalObjectId points at the immutable
/// ORIGINAL; it can never be changed (trigger in constraints.sql).
model PatientPhoto {
  /// Client-generated UUIDv7 accepted for offline capture (spec 8).
  id                 String      @id @default(uuid(7)) @db.Uuid
  organizationId     String      @db.Uuid
  patientId          String      @db.Uuid
  photoSessionId     String?     @db.Uuid
  protocolViewId     String?     @db.Uuid
  viewKey            String?
  source             PhotoSource
  status             PhotoStatus @default(UPLOAD_PENDING)
  originalObjectId   String      @db.Uuid
  capturedByUserId   String?     @db.Uuid
  capturedAt         DateTime    @db.Timestamptz(3)
  widthPx            Int?
  heightPx           Int?
  /// Device/lens/exposure/pose estimates (flexible metadata; no free text).
  captureMetadata    Json?
  /// Post-capture quality check results (flexible metadata).
  qualityChecks      Json?
  /// Ghost-alignment photographic position-match score (0..1).
  /// Never labelled medical accuracy (Bible 6.5).
  positionMatchScore Decimal?    @db.Decimal(5, 4)
  reviewedById       String?     @db.Uuid
  reviewedAt         DateTime?   @db.Timestamptz(3)
  reviewNote         String?
  archivedAt         DateTime?   @db.Timestamptz(3)
  createdAt          DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime    @updatedAt @db.Timestamptz(3)

  patient      Patient                  @relation(fields: [organizationId, patientId], references: [organizationId, id])
  photoSession PhotoSession?            @relation(fields: [organizationId, patientId, photoSessionId], references: [organizationId, patientId, id], onDelete: Restrict)
  protocolView PhotographyProtocolView? @relation(fields: [organizationId, protocolViewId], references: [organizationId, id], onDelete: Restrict)
  original     StorageObject            @relation(fields: [organizationId, originalObjectId], references: [organizationId, id])
  capturedBy   User?                    @relation("PhotoCapturedBy", fields: [capturedByUserId], references: [id], onDelete: Restrict)
  reviewedBy   User?                    @relation("PhotoReviewedBy", fields: [reviewedById], references: [id], onDelete: Restrict)

  derivatives         PhotoDerivative[]
  annotations         PhotoAnnotation[]
  tags                PhotoTag[]
  permissions         PhotoPermission[]
  mediaReleases       MediaRelease[]
  beforeSets          BeforeAfterSet[]          @relation("BeforePhoto")
  afterSets           BeforeAfterSet[]          @relation("AfterPhoto")
  simulationSources   SimulationVersionSource[]
  outcomeMeasurements OutcomeMeasurement[]

  @@unique([organizationId, id])
  @@unique([organizationId, patientId, id])
  @@unique([organizationId, originalObjectId])
  @@index([organizationId, patientId, capturedAt])
  @@index([organizationId, patientId, viewKey])
}

/// Every derivative references its source photo and generation metadata
/// (Bible 6.6). Derivatives are immutable; regeneration creates a new row.
model PhotoDerivative {
  id                 String         @id @default(uuid(7)) @db.Uuid
  organizationId     String         @db.Uuid
  patientId          String         @db.Uuid
  sourcePhotoId      String         @db.Uuid
  kind               DerivativeKind
  storageObjectId    String         @db.Uuid
  /// Generator name/version, parameters, transforms (flexible metadata).
  generationMetadata Json
  generatedByJobId   String?        @db.Uuid
  beforeAfterSetId   String?        @db.Uuid
  annotationId       String?        @db.Uuid
  createdById        String?        @db.Uuid
  createdAt          DateTime       @default(now()) @db.Timestamptz(3)

  sourcePhoto    PatientPhoto     @relation(fields: [organizationId, patientId, sourcePhotoId], references: [organizationId, patientId, id])
  storageObject  StorageObject    @relation(fields: [organizationId, storageObjectId], references: [organizationId, id])
  generatedByJob AIJob?           @relation(fields: [organizationId, generatedByJobId], references: [organizationId, id], onDelete: Restrict)
  beforeAfterSet BeforeAfterSet?  @relation(fields: [organizationId, patientId, beforeAfterSetId], references: [organizationId, patientId, id], onDelete: Restrict)
  annotation     PhotoAnnotation? @relation(fields: [organizationId, patientId, annotationId], references: [organizationId, patientId, id], onDelete: Restrict)
  createdBy      User?            @relation(fields: [createdById], references: [id], onDelete: Restrict)

  simulationOutputOf SimulationVersion?
  mediaReleases      MediaRelease[]
  caseLibraryDisplay CaseLibraryEntry[]

  @@unique([organizationId, id])
  @@unique([organizationId, patientId, id])
  @@unique([organizationId, storageObjectId])
  @@index([sourcePhotoId, kind])
}

/// Vector annotation layer (never burned into the original). Coordinates are
/// normalized 0..1 relative to the original image.
model PhotoAnnotation {
  /// Client-generated UUIDv7 accepted for offline annotation (spec 8).
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @db.Uuid
  patientId      String    @db.Uuid
  photoId        String    @db.Uuid
  authorUserId   String    @db.Uuid
  schemaVersion  Int       @default(1)
  layer          Json
  label          String?
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt      DateTime? @db.Timestamptz(3)
  version        Int       @default(1)

  photo                PatientPhoto      @relation(fields: [organizationId, patientId, photoId], references: [organizationId, patientId, id])
  author               User              @relation(fields: [authorUserId], references: [id])
  renderedDerivatives  PhotoDerivative[]

  @@unique([organizationId, patientId, id])
  @@index([photoId])
}

model PhotoTag {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @db.Uuid
  patientId      String   @db.Uuid
  photoId        String   @db.Uuid
  tag            String
  createdById    String?  @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  photo     PatientPhoto @relation(fields: [organizationId, patientId, photoId], references: [organizationId, patientId, id])
  createdBy User?        @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([photoId, tag])
  @@index([organizationId, tag])
}

/// Versioned, append-only media permission (Bible 7). Each change inserts a new
/// row and stamps supersededAt on the previous one; exactly one current row per
/// (patient, category, scope target) is enforced in constraints.sql.
/// No category implies another.
model PhotoPermission {
  id                          String                  @id @default(uuid(7)) @db.Uuid
  organizationId              String                  @db.Uuid
  patientId                   String                  @db.Uuid
  category                    MediaPermissionCategory
  scope                       PermissionScope
  photoSessionId              String?                 @db.Uuid
  photoId                     String?                 @db.Uuid
  state                       PhotoPermissionState
  versionNumber               Int
  previousVersionId           String?                 @db.Uuid
  effectiveAt                 DateTime                @db.Timestamptz(3)
  expiresAt                   DateTime?               @db.Timestamptz(3)
  evidence                    PermissionEvidence?
  evidenceConsentAssignmentId String?                 @db.Uuid
  reason                      String?
  recordedById                String?                 @db.Uuid
  createdAt                   DateTime                @default(now()) @db.Timestamptz(3)
  supersededAt                DateTime?               @db.Timestamptz(3)

  patient            Patient            @relation(fields: [organizationId, patientId], references: [organizationId, id])
  photoSession       PhotoSession?      @relation(fields: [organizationId, patientId, photoSessionId], references: [organizationId, patientId, id], onDelete: Restrict)
  photo              PatientPhoto?      @relation(fields: [organizationId, patientId, photoId], references: [organizationId, patientId, id], onDelete: Restrict)
  previousVersion    PhotoPermission?   @relation("PhotoPermissionHistory", fields: [organizationId, patientId, previousVersionId], references: [organizationId, patientId, id], onDelete: Restrict)
  nextVersion        PhotoPermission?   @relation("PhotoPermissionHistory")
  evidenceConsent    ConsentAssignment? @relation(fields: [organizationId, patientId, evidenceConsentAssignmentId], references: [organizationId, patientId, id], onDelete: Restrict)
  recordedBy         User?              @relation(fields: [recordedById], references: [id], onDelete: Restrict)

  releasePins        MediaReleasePermission[]

  @@unique([organizationId, patientId, id])
  @@unique([organizationId, patientId, previousVersionId])
  @@index([organizationId, patientId, category])
}

/// Record that a specific asset was released/exported for a purpose. Every
/// PhotoPermission version relied on at that moment is pinned in
/// MediaReleasePermission (a before/after or simulation can depend on several).
/// A release without at least one pinned permission is rejected at commit.
model MediaRelease {
  id               String                  @id @default(uuid(7)) @db.Uuid
  organizationId   String                  @db.Uuid
  patientId        String                  @db.Uuid
  purpose          MediaPermissionCategory
  photoId          String?                 @db.Uuid
  derivativeId     String?                 @db.Uuid
  beforeAfterSetId String?                 @db.Uuid
  simulationId     String?                 @db.Uuid
  releasedById     String                  @db.Uuid
  releasedAt       DateTime                @default(now()) @db.Timestamptz(3)
  revokedAt        DateTime?               @db.Timestamptz(3)
  revokedById      String?                 @db.Uuid
  revocationReason String?

  patient        Patient          @relation(fields: [organizationId, patientId], references: [organizationId, id])
  photo          PatientPhoto?    @relation(fields: [organizationId, patientId, photoId], references: [organizationId, patientId, id], onDelete: Restrict)
  derivative     PhotoDerivative? @relation(fields: [organizationId, patientId, derivativeId], references: [organizationId, patientId, id], onDelete: Restrict)
  beforeAfterSet BeforeAfterSet?  @relation(fields: [organizationId, patientId, beforeAfterSetId], references: [organizationId, patientId, id], onDelete: Restrict)
  simulation     Simulation?      @relation(fields: [organizationId, patientId, simulationId], references: [organizationId, patientId, id], onDelete: Restrict)
  releasedBy     User             @relation("MediaReleaseReleasedBy", fields: [releasedById], references: [id])
  revokedBy      User?            @relation("MediaReleaseRevokedBy", fields: [revokedById], references: [id], onDelete: Restrict)

  permissions        MediaReleasePermission[]
  caseLibraryEntries CaseLibraryEntry[]

  @@unique([organizationId, patientId, id])
  @@index([organizationId, patientId, purpose])
}

/// The exact permission versions a MediaRelease relied on. Append-only.
model MediaReleasePermission {
  organizationId String @db.Uuid
  patientId      String @db.Uuid
  mediaReleaseId String @db.Uuid
  permissionId   String @db.Uuid

  mediaRelease MediaRelease    @relation(fields: [organizationId, patientId, mediaReleaseId], references: [organizationId, patientId, id])
  permission   PhotoPermission @relation(fields: [organizationId, patientId, permissionId], references: [organizationId, patientId, id])

  @@id([mediaReleaseId, permissionId])
  @@index([permissionId])
}

/// Both photos are constrained by composite FKs to the SAME organization and
/// the SAME patient (Bible 8.1, acceptance 34.1 #12-13).
model BeforeAfterSet {
  id                    String           @id @default(uuid(7)) @db.Uuid
  organizationId        String           @db.Uuid
  patientId             String           @db.Uuid
  beforePhotoId         String           @db.Uuid
  afterPhotoId          String           @db.Uuid
  consultationId        String?          @db.Uuid
  viewKey               String?
  title                 String?
  registrationMode      RegistrationMode @default(NONE)
  /// 2D transform (normalized coordinates) applied at display time only.
  registrationTransform Json?
  registrationJobId     String?          @db.Uuid
  createdById           String           @db.Uuid
  createdAt             DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime         @updatedAt @db.Timestamptz(3)
  version               Int              @default(1)

  patient         Patient       @relation(fields: [organizationId, patientId], references: [organizationId, id])
  beforePhoto     PatientPhoto  @relation("BeforePhoto", fields: [organizationId, patientId, beforePhotoId], references: [organizationId, patientId, id])
  afterPhoto      PatientPhoto  @relation("AfterPhoto", fields: [organizationId, patientId, afterPhotoId], references: [organizationId, patientId, id])
  consultation    Consultation? @relation(fields: [organizationId, patientId, consultationId], references: [organizationId, patientId, id], onDelete: Restrict)
  registrationJob AIJob?        @relation(fields: [organizationId, registrationJobId], references: [organizationId, id], onDelete: Restrict)
  createdBy       User          @relation(fields: [createdById], references: [id])

  derivatives         PhotoDerivative[]
  mediaReleases       MediaRelease[]
  caseLibraryEntries  CaseLibraryEntry[]
  outcomeMeasurements OutcomeMeasurement[]

  @@unique([organizationId, id])
  @@unique([organizationId, patientId, id])
}

/// Provider request for patient-captured photos (Bible 13.4).
model PhotoRequest {
  id                String             @id @default(uuid(7)) @db.Uuid
  organizationId    String             @db.Uuid
  patientId         String             @db.Uuid
  protocolId        String             @db.Uuid
  requestedViewKeys String[]
  instructions      String?
  status            PhotoRequestStatus @default(OPEN)
  requestedById     String             @db.Uuid
  dueAt             DateTime?          @db.Timestamptz(3)
  submittedAt       DateTime?          @db.Timestamptz(3)
  completedAt       DateTime?          @db.Timestamptz(3)
  cancelledAt       DateTime?          @db.Timestamptz(3)
  createdAt         DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @db.Timestamptz(3)

  patient       Patient              @relation(fields: [organizationId, patientId], references: [organizationId, id])
  protocol      PhotographyProtocol  @relation(fields: [organizationId, protocolId], references: [organizationId, id])
  requestedBy   User                 @relation(fields: [requestedById], references: [id])
  photoSessions PhotoSession[]

  @@unique([organizationId, patientId, id])
}

// =============================================================================
// 5. AI
//    Bible entities: Simulation, SimulationVersion, SimulationParameter,
//    SimulationApproval, AIJob, AIModel, AIModelVersion, AIValidationRecord,
//    SimilarCaseMatch, OutcomeMeasurement
//    Additions: AIModelRollout (17.1 rollout controls / 9.7 rollback),
//    SimulationVersionSource (9.4 source asset IDs), CaseLibraryEntry (10)
// =============================================================================

enum AIModelTask {
  INPUT_QUALITY
  LANDMARK_DETECTION
  SEGMENTATION
  IDENTITY_REPRESENTATION
  SIMULATION
  ARTIFACT_DETECTION
  IDENTITY_SIMILARITY
  IMAGE_REGISTRATION
  SIMILAR_CASE_EMBEDDING
  OUTCOME_MEASUREMENT
}

enum AIModelVersionStatus {
  REGISTERED
  VALIDATING
  VALIDATED
  VALIDATION_FAILED
  RETIRED
}

enum RolloutState {
  ACTIVE
  INACTIVE
}

enum AIJobType {
  /// Thumbnail and display preview of an accepted photo (Layer 2; image processing, no model).
  IMAGE_DERIVATIVE
  INPUT_QUALITY_CHECK
  LANDMARK_DETECTION
  SEGMENTATION
  SIMULATION_GENERATION
  OUTPUT_VALIDATION
  IMAGE_REGISTRATION
  SIMILAR_CASE_SEARCH
  OUTCOME_MEASUREMENT
}

enum AIJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
  TIMED_OUT
}

enum SimulationCategory {
  LIP_FILLER
  RHINOPLASTY
  BOTULINUM_TOXIN
  CHEEK_CHIN_JAW_FILLER
  FACIAL_LIFT_PROCEDURES
  BREAST_BODY_CONTOUR
  SKIN_RESURFACING_TIGHTENING
}

enum SimulationStatus {
  DRAFT
  QUEUED
  PROCESSING
  VALIDATING
  READY_FOR_PROVIDER_REVIEW
  APPROVED
  REJECTED
  REGENERATING
  RELEASED_TO_PATIENT
  ARCHIVED
  FAILED
}

enum SimulationReviewDecision {
  APPROVED
  REJECTED
  REGENERATE_REQUESTED
}

enum SimulationSourceRole {
  PRIMARY
  ADDITIONAL_VIEW
}

enum ValidationCheckType {
  INPUT_QUALITY
  OUTSIDE_REGION_IDENTITY_SIMILARITY
  ARTIFACT_DETECTION
  OUTPUT_VALIDATION
  MODEL_BENCHMARK
  IDENTITY_PRESERVATION_REGRESSION
}

enum ValidationResult {
  PASS
  FLAG
  FAIL
}

enum CaseLibraryStatus {
  ACTIVE
  WITHDRAWN
}

enum MeasurementMethod {
  MANUAL
  AUTOMATED
}

/// Platform-level model registry (not tenant-owned).
model AIModel {
  id                 String              @id @default(uuid(7)) @db.Uuid
  key                String              @unique
  name               String
  task               AIModelTask
  simulationCategory SimulationCategory?
  description        String?
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(3)

  versions AIModelVersion[]
  rollouts AIModelRollout[]
}

/// Immutable once registered (trigger in constraints.sql). A production model
/// is never silently replaced: activation happens only via AIModelRollout.
model AIModelVersion {
  id                String               @id @default(uuid(7)) @db.Uuid
  modelId           String               @db.Uuid
  version           String
  /// SHA-256 digest of the weights / inference container image.
  artifactDigest    String
  /// Allow-list of provider controls and ranges. Contains no dosage, product,
  /// drug, units, depth or technique fields (Bible 9.6 / 34.2 #31).
  parameterSchema   Json
  inferenceDefaults Json
  /// Identity-similarity / artifact thresholds applied before review (9.5).
  thresholds        Json
  intendedUse       String
  validationSummary Json?
  status            AIModelVersionStatus @default(REGISTERED)
  registeredById    String?              @db.Uuid
  createdAt         DateTime             @default(now()) @db.Timestamptz(3)
  validatedAt       DateTime?            @db.Timestamptz(3)
  retiredAt         DateTime?            @db.Timestamptz(3)

  model              AIModel              @relation(fields: [modelId], references: [id])
  registeredBy       User?                @relation(fields: [registeredById], references: [id], onDelete: Restrict)
  rollouts           AIModelRollout[]
  jobs               AIJob[]
  simulationVersions SimulationVersion[]
  validationRecords  AIValidationRecord[]
  measurements       OutcomeMeasurement[]

  @@unique([modelId, version])
  @@unique([modelId, id])
}

/// Which model version is active, platform-wide (organizationId NULL) or for
/// one organization. One ACTIVE row per (model, organization) enforced in SQL.
/// Rollback = activate a previous version; history is never rewritten.
model AIModelRollout {
  id             String       @id @default(uuid(7)) @db.Uuid
  modelId        String       @db.Uuid
  modelVersionId String       @db.Uuid
  organizationId String?      @db.Uuid
  state          RolloutState
  reason         String?
  changedById    String       @db.Uuid
  activatedAt    DateTime     @default(now()) @db.Timestamptz(3)
  deactivatedAt  DateTime?    @db.Timestamptz(3)

  model        AIModel        @relation(fields: [modelId], references: [id])
  modelVersion AIModelVersion @relation(fields: [modelId, modelVersionId], references: [modelId, id])
  organization Organization?  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  changedBy    User           @relation(fields: [changedById], references: [id])

  @@index([modelId, organizationId, state])
}

/// Generic job record (spec 5.8): image derivatives from Layer 2 (ADR-0023 K2-06),
/// before/after registration from Layer 3, AI jobs from Layer 7 (model FK).
model AIJob {
  id             String      @id @default(uuid(7)) @db.Uuid
  organizationId String      @db.Uuid
  patientId      String?     @db.Uuid
  jobType        AIJobType
  status         AIJobStatus @default(QUEUED)
  modelVersionId String?     @db.Uuid
  /// Prevents duplicate AI jobs on retry (Bible 20.3 / 23.3).
  idempotencyKey String
  requestedById  String?     @db.Uuid
  attempt        Int         @default(0)
  /// Identifiers and parameters only; never image bytes or free-text PHI.
  inputSummary   Json?
  /// Scores/metrics only; never image bytes or free-text PHI.
  resultSummary  Json?
  errorCode      String?
  queuedAt       DateTime    @default(now()) @db.Timestamptz(3)
  startedAt      DateTime?   @db.Timestamptz(3)
  finishedAt     DateTime?   @db.Timestamptz(3)
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @db.Timestamptz(3)

  organization Organization    @relation(fields: [organizationId], references: [id])
  patient      Patient?        @relation(fields: [organizationId, patientId], references: [organizationId, id], onDelete: Restrict)
  modelVersion AIModelVersion? @relation(fields: [modelVersionId], references: [id], onDelete: Restrict)
  requestedBy  User?           @relation(fields: [requestedById], references: [id], onDelete: Restrict)

  derivatives        PhotoDerivative[]
  registrations      BeforeAfterSet[]
  simulationVersion  SimulationVersion?
  validationRecords  AIValidationRecord[]
  similarCaseMatches SimilarCaseMatch[]
  measurements       OutcomeMeasurement[]

  @@unique([organizationId, id])
  @@unique([organizationId, idempotencyKey])
  @@index([status, queuedAt])
}

/// A clinician-controlled visualization for one patient and category. The
/// canonical state machine (Bible 9.3 / Appendix A) lives here; each generation
/// attempt is a SimulationVersion.
model Simulation {
  id                String             @id @default(uuid(7)) @db.Uuid
  organizationId    String             @db.Uuid
  patientId         String             @db.Uuid
  consultationId    String?            @db.Uuid
  category          SimulationCategory
  /// Specific procedure within the category, e.g. BLEPHAROPLASTY.
  procedureKey      String?
  treatmentRegion   String
  status            SimulationStatus   @default(DRAFT)
  /// Provider parameters edited while DRAFT (validated against the active
  /// model's allow-list at /generate, then frozen into SimulationParameter rows).
  draftParameters   Json?
  /// The approved version released to the patient (set on RELEASED_TO_PATIENT).
  releasedVersionId String?            @db.Uuid
  createdById       String             @db.Uuid
  releasedAt        DateTime?          @db.Timestamptz(3)
  releasedById      String?            @db.Uuid
  archivedAt        DateTime?          @db.Timestamptz(3)
  createdAt         DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @db.Timestamptz(3)
  version           Int                @default(1)

  patient         Patient            @relation(fields: [organizationId, patientId], references: [organizationId, id])
  consultation    Consultation?      @relation(fields: [organizationId, patientId, consultationId], references: [organizationId, patientId, id], onDelete: Restrict)
  releasedVersion SimulationVersion? @relation("SimulationReleasedVersion", fields: [id, releasedVersionId], references: [simulationId, id], onDelete: Restrict)
  createdBy       User               @relation("SimulationCreatedBy", fields: [createdById], references: [id])
  releasedBy      User?              @relation("SimulationReleasedBy", fields: [releasedById], references: [id], onDelete: Restrict)

  versions           SimulationVersion[]  @relation("SimulationVersions")
  approvals          SimulationApproval[]
  mediaReleases      MediaRelease[]
  similarCaseMatches SimilarCaseMatch[]

  @@unique([organizationId, id])
  @@unique([organizationId, patientId, id])
  @@unique([id, releasedVersionId])
  @@index([organizationId, patientId, status])
}

/// One generation attempt with full provenance (Bible 9.4). Immutable after
/// completion (trigger in constraints.sql).
model SimulationVersion {
  id                 String    @id @default(uuid(7)) @db.Uuid
  organizationId     String    @db.Uuid
  patientId          String    @db.Uuid
  simulationId       String    @db.Uuid
  versionNumber      Int
  aiJobId            String?   @db.Uuid
  modelVersionId     String    @db.Uuid
  /// Fully resolved inference configuration incl. provider-set parameters.
  inferenceConfig    Json
  outputDerivativeId String?   @db.Uuid
  /// Segmentation mask, when retained (Bible 9.4).
  maskObjectId       String?   @db.Uuid
  generatedById      String    @db.Uuid
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)
  completedAt        DateTime? @db.Timestamptz(3)

  simulation       Simulation       @relation("SimulationVersions", fields: [organizationId, patientId, simulationId], references: [organizationId, patientId, id])
  aiJob            AIJob?           @relation(fields: [organizationId, aiJobId], references: [organizationId, id], onDelete: Restrict)
  modelVersion     AIModelVersion   @relation(fields: [modelVersionId], references: [id])
  outputDerivative PhotoDerivative? @relation(fields: [organizationId, patientId, outputDerivativeId], references: [organizationId, patientId, id], onDelete: Restrict)
  maskObject       StorageObject?   @relation(fields: [organizationId, maskObjectId], references: [organizationId, id], onDelete: Restrict)
  generatedBy      User             @relation(fields: [generatedById], references: [id])

  sources           SimulationVersionSource[]
  parameters        SimulationParameter[]
  approvals         SimulationApproval[]
  validationRecords AIValidationRecord[]
  releasedFor       Simulation?               @relation("SimulationReleasedVersion")

  @@unique([simulationId, versionNumber])
  @@unique([simulationId, id])
  @@unique([organizationId, id])
  @@unique([organizationId, patientId, id])
  @@unique([organizationId, aiJobId])
  @@unique([organizationId, patientId, outputDerivativeId])
  @@unique([organizationId, maskObjectId])
}

/// Source images for a generation. The composite FK to PatientPhoto includes
/// patientId, so a simulation can never use another patient's photo.
model SimulationVersionSource {
  organizationId      String               @db.Uuid
  patientId           String               @db.Uuid
  simulationVersionId String               @db.Uuid
  photoId             String               @db.Uuid
  role                SimulationSourceRole

  simulationVersion SimulationVersion @relation(fields: [organizationId, patientId, simulationVersionId], references: [organizationId, patientId, id])
  photo             PatientPhoto      @relation(fields: [organizationId, patientId, photoId], references: [organizationId, patientId, id])

  @@id([simulationVersionId, photoId])
}

/// Provider-set visualization parameter, validated against the model
/// version's parameterSchema allow-list.
model SimulationParameter {
  id                  String   @id @default(uuid(7)) @db.Uuid
  organizationId      String   @db.Uuid
  simulationVersionId String   @db.Uuid
  key                 String
  numericValue        Decimal? @db.Decimal(10, 4)
  optionValue         String?

  simulationVersion SimulationVersion @relation(fields: [organizationId, simulationVersionId], references: [organizationId, id])

  @@unique([simulationVersionId, key])
}

/// Append-only provider review decision on a specific version. The reviewer is
/// a ProviderProfile of the same organization (Bible 9.4 "reviewing provider").
model SimulationApproval {
  id                  String                   @id @default(uuid(7)) @db.Uuid
  organizationId      String                   @db.Uuid
  patientId           String                   @db.Uuid
  simulationId        String                   @db.Uuid
  simulationVersionId String                   @db.Uuid
  decision            SimulationReviewDecision
  reviewerUserId      String                   @db.Uuid
  reason              String?
  decidedAt           DateTime                 @default(now()) @db.Timestamptz(3)

  simulation        Simulation        @relation(fields: [organizationId, patientId, simulationId], references: [organizationId, patientId, id])
  simulationVersion SimulationVersion @relation(fields: [simulationId, simulationVersionId], references: [simulationId, id])
  reviewer          ProviderProfile   @relation(fields: [organizationId, reviewerUserId], references: [organizationId, userId])

  @@index([simulationId, decidedAt])
}

/// Validation evidence for a job/output (organization-scoped) or for a model
/// version benchmark (organizationId NULL).
model AIValidationRecord {
  id                  String              @id @default(uuid(7)) @db.Uuid
  organizationId      String?             @db.Uuid
  aiJobId             String?             @db.Uuid
  simulationVersionId String?             @db.Uuid
  modelVersionId      String?             @db.Uuid
  checkType           ValidationCheckType
  result              ValidationResult
  score               Decimal?            @db.Decimal(9, 6)
  threshold           Decimal?            @db.Decimal(9, 6)
  details             Json?
  validatorVersion    String
  createdAt           DateTime            @default(now()) @db.Timestamptz(3)

  aiJob             AIJob?             @relation(fields: [organizationId, aiJobId], references: [organizationId, id], onDelete: Restrict)
  simulationVersion SimulationVersion? @relation(fields: [organizationId, simulationVersionId], references: [organizationId, id], onDelete: Restrict)
  modelVersion      AIModelVersion?    @relation(fields: [modelVersionId], references: [id], onDelete: Restrict)

  @@index([simulationVersionId])
  @@index([modelVersionId])
}

/// Permission-gated historical case library (Bible 10). Shared across the
/// practices of one organization, never across organizations (D-01); practiceId
/// records the originating practice. Library use is authorized by a MediaRelease
/// (which pins the permission versions relied on); revoking it withdraws the entry.
model CaseLibraryEntry {
  id                  String            @id @default(uuid(7)) @db.Uuid
  organizationId      String            @db.Uuid
  practiceId          String            @db.Uuid
  patientId           String            @db.Uuid
  beforeAfterSetId    String            @db.Uuid
  treatmentId         String?           @db.Uuid
  viewKey             String?
  status              CaseLibraryStatus @default(ACTIVE)
  /// The release authorizing library use (required category: UD-10).
  mediaReleaseId      String            @db.Uuid
  /// De-identified display derivative shown to other patients.
  displayDerivativeId String?           @db.Uuid
  addedById           String            @db.Uuid
  addedAt             DateTime          @default(now()) @db.Timestamptz(3)
  withdrawnAt         DateTime?         @db.Timestamptz(3)
  withdrawalReason    String?

  beforeAfterSet    BeforeAfterSet   @relation(fields: [organizationId, patientId, beforeAfterSetId], references: [organizationId, patientId, id])
  treatment         Treatment?       @relation(fields: [organizationId, treatmentId], references: [organizationId, id], onDelete: Restrict)
  practice          Practice         @relation(fields: [organizationId, practiceId], references: [organizationId, id])
  mediaRelease      MediaRelease     @relation(fields: [organizationId, patientId, mediaReleaseId], references: [organizationId, patientId, id])
  displayDerivative PhotoDerivative? @relation(fields: [organizationId, patientId, displayDerivativeId], references: [organizationId, patientId, id], onDelete: Restrict)
  addedBy           User             @relation(fields: [addedById], references: [id])
  matches           SimilarCaseMatch[]

  @@unique([organizationId, id])
  @@unique([organizationId, beforeAfterSetId])
  @@index([organizationId, practiceId, status])
}

/// Records which historical cases were shown, to whom and when (Bible 10).
/// Results are labelled "Similar Historical Cases", never a predicted result.
model SimilarCaseMatch {
  id                 String    @id @default(uuid(7)) @db.Uuid
  organizationId     String    @db.Uuid
  /// The patient in consultation (the query), not the historical case owner.
  patientId          String    @db.Uuid
  consultationId     String?   @db.Uuid
  simulationId       String?   @db.Uuid
  caseLibraryEntryId String    @db.Uuid
  searchJobId        String?   @db.Uuid
  rank               Int
  similarityScore    Decimal?  @db.Decimal(9, 6)
  shownAt            DateTime? @db.Timestamptz(3)
  shownById          String?   @db.Uuid
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)

  patient          Patient          @relation(fields: [organizationId, patientId], references: [organizationId, id])
  consultation     Consultation?    @relation(fields: [organizationId, patientId, consultationId], references: [organizationId, patientId, id], onDelete: Restrict)
  simulation       Simulation?      @relation(fields: [organizationId, patientId, simulationId], references: [organizationId, patientId, id], onDelete: Restrict)
  caseLibraryEntry CaseLibraryEntry @relation(fields: [organizationId, caseLibraryEntryId], references: [organizationId, id])
  searchJob        AIJob?           @relation(fields: [organizationId, searchJobId], references: [organizationId, id], onDelete: Restrict)
  shownBy          User?            @relation(fields: [shownById], references: [id], onDelete: Restrict)

  @@index([organizationId, consultationId])
}

model OutcomeMeasurement {
  id               String            @id @default(uuid(7)) @db.Uuid
  organizationId   String            @db.Uuid
  patientId        String            @db.Uuid
  beforeAfterSetId String?           @db.Uuid
  photoId          String?           @db.Uuid
  measurementKey   String
  value            Decimal           @db.Decimal(12, 4)
  unit             String
  method           MeasurementMethod
  aiJobId          String?           @db.Uuid
  modelVersionId   String?           @db.Uuid
  measuredById     String?           @db.Uuid
  measuredAt       DateTime          @db.Timestamptz(3)
  notes            String?
  createdAt        DateTime          @default(now()) @db.Timestamptz(3)

  patient        Patient         @relation(fields: [organizationId, patientId], references: [organizationId, id])
  beforeAfterSet BeforeAfterSet? @relation(fields: [organizationId, patientId, beforeAfterSetId], references: [organizationId, patientId, id], onDelete: Restrict)
  photo          PatientPhoto?   @relation(fields: [organizationId, patientId, photoId], references: [organizationId, patientId, id], onDelete: Restrict)
  aiJob          AIJob?          @relation(fields: [organizationId, aiJobId], references: [organizationId, id], onDelete: Restrict)
  modelVersion   AIModelVersion? @relation(fields: [modelVersionId], references: [id], onDelete: Restrict)
  measuredBy     User?           @relation(fields: [measuredById], references: [id], onDelete: Restrict)

  @@index([organizationId, patientId, measurementKey])
}

// =============================================================================
// 6. DOCUMENTS, CONSENTS, INSTRUCTIONS & EDUCATION
//    Bible entities: ConsentTemplate, ConsentTemplateVersion, ConsentAssignment,
//    ConsentSignature, Document, DocumentVersion, PatientInstruction,
//    EducationContent, ContentAssignment
//    Additions: EducationContentVersion (12.5 / Layer 4 "versioned content")
// =============================================================================

enum TemplateVersionStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

enum ConsentStatus {
  DRAFT
  ASSIGNED
  VIEWED
  IN_PROGRESS
  SIGNED_BY_PATIENT
  SIGNED_BY_PROVIDER
  COMPLETE
  VOIDED
  SUPERSEDED
}

enum SignerRole {
  PATIENT
  PROVIDER
  WITNESS
}

enum SignatureMethod {
  DRAWN
  TYPED
}

enum DocumentType {
  CONSULTATION_SUMMARY
  SIGNED_CONSENT
  TREATMENT_PLAN
  ESTIMATE
  UPLOADED_CLINICAL
  EXTERNAL_EMR
  OTHER
}

enum DocumentStatus {
  ACTIVE
  ARCHIVED
}

enum EducationContentType {
  VIDEO
  IMAGE
  ANIMATION
  TEXT
  PDF
  PROCEDURE_EXPLANATION
  FAQ
  PRE_OP_INSTRUCTION
  POST_OP_INSTRUCTION
}

enum ContentAssignmentStatus {
  ASSIGNED
  OPENED
  VIEWED
  COMPLETED
  ACKNOWLEDGED
}

model ConsentTemplate {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @db.Uuid
  practiceId     String?   @db.Uuid
  name           String
  description    String?
  retiredAt      DateTime? @db.Timestamptz(3)
  createdById    String    @db.Uuid
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  organization Organization             @relation(fields: [organizationId], references: [id])
  practice     Practice?                @relation(fields: [organizationId, practiceId], references: [organizationId, id], onDelete: Restrict)
  createdBy    User                     @relation(fields: [createdById], references: [id])
  versions     ConsentTemplateVersion[]

  @@unique([organizationId, id])
}

/// Editable only while DRAFT; PUBLISHED versions are immutable (trigger).
/// Executed documents never change when a template is edited (Bible 12.2).
model ConsentTemplateVersion {
  id                        String                @id @default(uuid(7)) @db.Uuid
  organizationId            String                @db.Uuid
  templateId                String                @db.Uuid
  versionNumber             Int
  status                    TemplateVersionStatus @default(DRAFT)
  /// Ordered builder blocks (Bible 12.1), validated against a versioned JSON schema.
  blocks                    Json
  requiresProviderSignature Boolean               @default(false)
  requiresWitnessSignature  Boolean               @default(false)
  /// SHA-256 of the canonicalized blocks, set at publish.
  contentHash               String?
  createdById               String                @db.Uuid
  publishedAt               DateTime?             @db.Timestamptz(3)
  publishedById             String?               @db.Uuid
  createdAt                 DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt                 DateTime              @updatedAt @db.Timestamptz(3)

  template    ConsentTemplate     @relation(fields: [organizationId, templateId], references: [organizationId, id])
  createdBy   User                @relation("ConsentVersionCreatedBy", fields: [createdById], references: [id])
  publishedBy User?               @relation("ConsentVersionPublishedBy", fields: [publishedById], references: [id], onDelete: Restrict)
  assignments ConsentAssignment[]

  @@unique([templateId, versionNumber])
  @@unique([organizationId, id])
}

/// A consent issued to a patient; carries the Bible 12.4 state machine.
model ConsentAssignment {
  id                        String        @id @default(uuid(7)) @db.Uuid
  organizationId            String        @db.Uuid
  patientId                 String        @db.Uuid
  templateVersionId         String        @db.Uuid
  consultationId            String?       @db.Uuid
  procedureId               String?       @db.Uuid
  treatmentPlanId           String?       @db.Uuid
  status                    ConsentStatus @default(DRAFT)
  /// Captured field values keyed by block id (checkboxes, initials, text, dates).
  responses                 Json?
  assignedById              String        @db.Uuid
  assignedAt                DateTime?     @db.Timestamptz(3)
  dueAt                     DateTime?     @db.Timestamptz(3)
  firstViewedAt             DateTime?     @db.Timestamptz(3)
  patientSignedAt           DateTime?     @db.Timestamptz(3)
  providerSignedAt          DateTime?     @db.Timestamptz(3)
  completedAt               DateTime?     @db.Timestamptz(3)
  /// Immutable signed snapshot (PDF) + its SHA-256 (Bible 12.3).
  signedDocumentVersionId   String?       @db.Uuid
  signedSnapshotHash        String?
  voidedAt                  DateTime?     @db.Timestamptz(3)
  voidedById                String?       @db.Uuid
  voidReason                String?
  supersededAt              DateTime?     @db.Timestamptz(3)
  supersededByAssignmentId  String?       @db.Uuid
  createdAt                 DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt                 DateTime      @updatedAt @db.Timestamptz(3)
  version                   Int           @default(1)

  patient               Patient                @relation(fields: [organizationId, patientId], references: [organizationId, id])
  templateVersion       ConsentTemplateVersion @relation(fields: [organizationId, templateVersionId], references: [organizationId, id])
  consultation          Consultation?          @relation(fields: [organizationId, patientId, consultationId], references: [organizationId, patientId, id], onDelete: Restrict)
  procedure             Procedure?             @relation(fields: [organizationId, patientId, procedureId], references: [organizationId, patientId, id], onDelete: Restrict)
  treatmentPlan         TreatmentPlan?         @relation(fields: [organizationId, patientId, treatmentPlanId], references: [organizationId, patientId, id], onDelete: Restrict)
  assignedBy            User                   @relation("ConsentAssignedBy", fields: [assignedById], references: [id])
  voidedBy              User?                  @relation("ConsentVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)
  signedDocumentVersion DocumentVersion?       @relation(fields: [organizationId, patientId, signedDocumentVersionId], references: [organizationId, patientId, id], onDelete: Restrict)
  supersededBy          ConsentAssignment?     @relation("ConsentSupersession", fields: [organizationId, patientId, supersededByAssignmentId], references: [organizationId, patientId, id], onDelete: Restrict)
  supersedes            ConsentAssignment?     @relation("ConsentSupersession")

  signatures          ConsentSignature[]
  permissionEvidenceFor PhotoPermission[]

  @@unique([organizationId, id])
  @@unique([organizationId, patientId, id])
  @@unique([organizationId, patientId, signedDocumentVersionId])
  @@unique([organizationId, patientId, supersededByAssignmentId])
  @@index([organizationId, patientId, status])
}

model ConsentSignature {
  id                  String          @id @default(uuid(7)) @db.Uuid
  organizationId      String          @db.Uuid
  patientId           String          @db.Uuid
  consentAssignmentId String          @db.Uuid
  signerRole          SignerRole
  /// NULL for a witness who is not a platform user.
  signerUserId        String?         @db.Uuid
  signerName          String
  method              SignatureMethod
  signatureObjectId   String          @db.Uuid
  /// Exact attestation text displayed at signing.
  attestation         String
  signedAt            DateTime        @default(now()) @db.Timestamptz(3)
  ipAddress           String?         @db.Inet
  deviceId            String?         @db.Uuid
  /// Prevents duplicate signatures on retry (Bible 20.3 / 23.3).
  idempotencyKey      String

  consentAssignment ConsentAssignment @relation(fields: [organizationId, patientId, consentAssignmentId], references: [organizationId, patientId, id])
  signer            User?             @relation(fields: [signerUserId], references: [id], onDelete: Restrict)
  signatureObject   StorageObject     @relation(fields: [organizationId, signatureObjectId], references: [organizationId, id])
  device            Device?           @relation(fields: [deviceId], references: [id], onDelete: Restrict)

  @@unique([consentAssignmentId, signerRole])
  @@unique([organizationId, idempotencyKey])
  @@unique([organizationId, signatureObjectId])
}

model Document {
  id                  String         @id @default(uuid(7)) @db.Uuid
  organizationId      String         @db.Uuid
  patientId           String         @db.Uuid
  type                DocumentType
  title               String
  consultationId      String?        @db.Uuid
  status              DocumentStatus @default(ACTIVE)
  /// Patient-app visibility requires an explicit release (Bible 13.2).
  releasedToPatientAt DateTime?      @db.Timestamptz(3)
  releasedById        String?        @db.Uuid
  createdById         String?        @db.Uuid
  createdAt           DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime       @updatedAt @db.Timestamptz(3)

  patient      Patient       @relation(fields: [organizationId, patientId], references: [organizationId, id])
  consultation Consultation? @relation(fields: [organizationId, patientId, consultationId], references: [organizationId, patientId, id], onDelete: Restrict)
  releasedBy   User?         @relation("DocumentReleasedBy", fields: [releasedById], references: [id], onDelete: Restrict)
  createdBy    User?         @relation("DocumentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  versions  DocumentVersion[]
  messages  Message[]
  estimates Estimate[]

  @@unique([organizationId, id])
  @@unique([organizationId, patientId, id])
  @@index([organizationId, patientId, type])
}

/// Immutable file version (trigger). New content = new version.
model DocumentVersion {
  id              String   @id @default(uuid(7)) @db.Uuid
  organizationId  String   @db.Uuid
  patientId       String   @db.Uuid
  documentId      String   @db.Uuid
  versionNumber   Int
  storageObjectId String   @db.Uuid
  sha256          String
  changeNote      String?
  createdById     String?  @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  document      Document      @relation(fields: [organizationId, patientId, documentId], references: [organizationId, patientId, id])
  storageObject StorageObject @relation(fields: [organizationId, storageObjectId], references: [organizationId, id])
  createdBy     User?         @relation(fields: [createdById], references: [id], onDelete: Restrict)

  signedConsent ConsentAssignment?

  @@unique([documentId, versionNumber])
  @@unique([organizationId, patientId, id])
  @@unique([organizationId, storageObjectId])
}

/// Organization content library item (Bible 12.5). Content must be original
/// or licensed - never copied vendor education content (Bible 0.1).
model EducationContent {
  id             String               @id @default(uuid(7)) @db.Uuid
  organizationId String               @db.Uuid
  contentType    EducationContentType
  title          String
  treatmentId    String?              @db.Uuid
  retiredAt      DateTime?            @db.Timestamptz(3)
  createdById    String?              @db.Uuid
  createdAt      DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime             @updatedAt @db.Timestamptz(3)

  organization Organization              @relation(fields: [organizationId], references: [id])
  treatment    Treatment?                @relation(fields: [organizationId, treatmentId], references: [organizationId, id], onDelete: Restrict)
  createdBy    User?                     @relation(fields: [createdById], references: [id], onDelete: Restrict)
  versions     EducationContentVersion[]

  @@unique([organizationId, id])
}

model EducationContentVersion {
  id              String                @id @default(uuid(7)) @db.Uuid
  organizationId  String                @db.Uuid
  contentId       String                @db.Uuid
  versionNumber   Int
  status          TemplateVersionStatus @default(DRAFT)
  /// Structured text / FAQ / instruction blocks (flexible content).
  body            Json?
  mediaObjectId   String?               @db.Uuid
  durationSeconds Int?
  publishedAt     DateTime?             @db.Timestamptz(3)
  publishedById   String?               @db.Uuid
  createdAt       DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime              @updatedAt @db.Timestamptz(3)

  content     EducationContent @relation(fields: [organizationId, contentId], references: [organizationId, id])
  mediaObject StorageObject?   @relation(fields: [organizationId, mediaObjectId], references: [organizationId, id], onDelete: Restrict)
  publishedBy User?            @relation(fields: [publishedById], references: [id], onDelete: Restrict)

  assignments  ContentAssignment[]
  instructions PatientInstruction[]

  @@unique([contentId, versionNumber])
  @@unique([organizationId, id])
}

/// Education assigned to a patient; tracks the Bible 12.5 engagement states.
model ContentAssignment {
  id                        String                  @id @default(uuid(7)) @db.Uuid
  organizationId            String                  @db.Uuid
  patientId                 String                  @db.Uuid
  contentVersionId          String                  @db.Uuid
  consultationId            String?                 @db.Uuid
  procedureId               String?                 @db.Uuid
  status                    ContentAssignmentStatus @default(ASSIGNED)
  assignedById              String                  @db.Uuid
  assignedAt                DateTime                @default(now()) @db.Timestamptz(3)
  presentedInConsultationAt DateTime?               @db.Timestamptz(3)
  openedAt                  DateTime?               @db.Timestamptz(3)
  viewedAt                  DateTime?               @db.Timestamptz(3)
  completedAt               DateTime?               @db.Timestamptz(3)
  acknowledgedAt            DateTime?               @db.Timestamptz(3)
  createdAt                 DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt                 DateTime                @updatedAt @db.Timestamptz(3)

  patient        Patient                 @relation(fields: [organizationId, patientId], references: [organizationId, id])
  contentVersion EducationContentVersion @relation(fields: [organizationId, contentVersionId], references: [organizationId, id])
  consultation   Consultation?           @relation(fields: [organizationId, patientId, consultationId], references: [organizationId, patientId, id], onDelete: Restrict)
  procedure      Procedure?              @relation(fields: [organizationId, patientId, procedureId], references: [organizationId, patientId, id], onDelete: Restrict)
  assignedBy     User                    @relation(fields: [assignedById], references: [id])

  @@index([organizationId, patientId, status])
}

/// Versioned instruction assigned by procedure or consultation. Patient
/// acknowledgment is tracked separately from clinical completion (Bible 12.6).
model PatientInstruction {
  id                    String    @id @default(uuid(7)) @db.Uuid
  organizationId        String    @db.Uuid
  patientId             String    @db.Uuid
  contentVersionId      String    @db.Uuid
  procedureId           String?   @db.Uuid
  consultationId        String?   @db.Uuid
  assignedById          String    @db.Uuid
  assignedAt            DateTime  @default(now()) @db.Timestamptz(3)
  releasedToPatientAt   DateTime? @db.Timestamptz(3)
  patientAcknowledgedAt DateTime? @db.Timestamptz(3)
  clinicalCompletedAt   DateTime? @db.Timestamptz(3)
  clinicalCompletedById String?   @db.Uuid
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  patient             Patient                 @relation(fields: [organizationId, patientId], references: [organizationId, id])
  contentVersion      EducationContentVersion @relation(fields: [organizationId, contentVersionId], references: [organizationId, id])
  procedure           Procedure?              @relation(fields: [organizationId, patientId, procedureId], references: [organizationId, patientId, id], onDelete: Restrict)
  consultation        Consultation?           @relation(fields: [organizationId, patientId, consultationId], references: [organizationId, patientId, id], onDelete: Restrict)
  assignedBy          User                    @relation("InstructionAssignedBy", fields: [assignedById], references: [id])
  clinicalCompletedBy User?                   @relation("InstructionCompletedBy", fields: [clinicalCompletedById], references: [id], onDelete: Restrict)
  messages            Message[]

  @@unique([organizationId, patientId, id])
}

// =============================================================================
// 7. COMMUNICATION
//    Bible entities: MessageThread, ThreadParticipant, Message,
//    MessageAttachment, Notification, TelehealthSession
// =============================================================================

enum ThreadStatus {
  OPEN
  CLOSED
}

enum ParticipantKind {
  PATIENT
  STAFF
}

enum MessageStatus {
  DRAFT
  SENT
  DELIVERED
  READ
  FAILED
}

enum AttachmentKind {
  IMAGE
  DOCUMENT
}

enum NotificationChannel {
  PUSH
  EMAIL
  SMS
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  SUPPRESSED
}

enum TelehealthStatus {
  SCHEDULED
  WAITING
  ACTIVE
  DISCONNECTED
  ENDED
  CANCELLED
}

model MessageThread {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @db.Uuid
  patientId      String       @db.Uuid
  practiceId     String?      @db.Uuid
  subject        String?
  status         ThreadStatus @default(OPEN)
  createdById    String       @db.Uuid
  lastMessageAt  DateTime?    @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)

  patient      Patient             @relation(fields: [organizationId, patientId], references: [organizationId, id])
  practice     Practice?           @relation(fields: [organizationId, practiceId], references: [organizationId, id], onDelete: Restrict)
  createdBy    User                @relation(fields: [createdById], references: [id])
  participants ThreadParticipant[]
  messages     Message[]

  @@unique([organizationId, id])
  @@unique([organizationId, patientId, id])
  @@index([organizationId, patientId, lastMessageAt])
}

/// Access to a thread requires membership here PLUS the applicable permission.
model ThreadParticipant {
  id             String          @id @default(uuid(7)) @db.Uuid
  organizationId String          @db.Uuid
  threadId       String          @db.Uuid
  userId         String          @db.Uuid
  kind           ParticipantKind
  joinedAt       DateTime        @default(now()) @db.Timestamptz(3)
  leftAt         DateTime?       @db.Timestamptz(3)
  lastReadAt     DateTime?       @db.Timestamptz(3)

  thread MessageThread @relation(fields: [organizationId, threadId], references: [organizationId, id])
  user   User          @relation(fields: [userId], references: [id])

  @@unique([threadId, userId])
  @@index([userId])
}

model Message {
  /// Client-generated UUIDv7 accepted so retried sends never duplicate.
  id                   String        @id @default(uuid(7)) @db.Uuid
  organizationId       String        @db.Uuid
  patientId            String        @db.Uuid
  threadId             String        @db.Uuid
  senderUserId         String        @db.Uuid
  body                 String?
  status               MessageStatus @default(DRAFT)
  documentId           String?       @db.Uuid
  patientInstructionId String?       @db.Uuid
  sentAt               DateTime?     @db.Timestamptz(3)
  deliveredAt          DateTime?     @db.Timestamptz(3)
  readAt               DateTime?     @db.Timestamptz(3)
  failedAt             DateTime?     @db.Timestamptz(3)
  failureCode          String?
  retryCount           Int           @default(0)
  nextRetryAt          DateTime?     @db.Timestamptz(3)
  createdAt            DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime      @updatedAt @db.Timestamptz(3)

  thread             MessageThread       @relation(fields: [organizationId, patientId, threadId], references: [organizationId, patientId, id])
  sender             User                @relation(fields: [senderUserId], references: [id])
  document           Document?           @relation(fields: [organizationId, patientId, documentId], references: [organizationId, patientId, id], onDelete: Restrict)
  patientInstruction PatientInstruction? @relation(fields: [organizationId, patientId, patientInstructionId], references: [organizationId, patientId, id], onDelete: Restrict)
  attachments        MessageAttachment[]

  @@unique([organizationId, id])
  @@index([threadId, createdAt])
}

model MessageAttachment {
  id              String         @id @default(uuid(7)) @db.Uuid
  organizationId  String         @db.Uuid
  messageId       String         @db.Uuid
  storageObjectId String         @db.Uuid
  kind            AttachmentKind
  /// Sanitized display name; never used as a storage path.
  fileName        String
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)

  message       Message       @relation(fields: [organizationId, messageId], references: [organizationId, id])
  storageObject StorageObject @relation(fields: [organizationId, storageObjectId], references: [organizationId, id])

  @@unique([organizationId, storageObjectId])
  @@index([messageId])
}

/// Outbound notification. Payload text comes from templateKey only and never
/// contains patient or clinical content (Bible 14.3).
model Notification {
  id                String              @id @default(uuid(7)) @db.Uuid
  organizationId    String?             @db.Uuid
  userId            String              @db.Uuid
  channel           NotificationChannel
  /// e.g. NEW_SECURE_MESSAGE -> "You have a new secure message."
  templateKey       String
  status            NotificationStatus  @default(PENDING)
  /// Opaque in-app route; the app re-authorizes before showing anything.
  deepLink          String?
  resourceType      String?
  resourceId        String?             @db.Uuid
  attempts          Int                 @default(0)
  providerMessageId String?
  lastErrorCode     String?
  createdAt         DateTime            @default(now()) @db.Timestamptz(3)
  sentAt            DateTime?           @db.Timestamptz(3)
  deliveredAt       DateTime?           @db.Timestamptz(3)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User          @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

/// Calls are NOT recorded (Bible 16.2); there is intentionally no recording field.
model TelehealthSession {
  id                 String           @id @default(uuid(7)) @db.Uuid
  organizationId     String           @db.Uuid
  patientId          String           @db.Uuid
  appointmentId      String?          @db.Uuid
  consultationId     String?          @db.Uuid
  hostUserId         String           @db.Uuid
  status             TelehealthStatus @default(SCHEDULED)
  /// Video vendor adapter key (vendor selection: UD-05).
  vendor             String
  vendorSessionRef   String?
  scheduledStartAt   DateTime         @db.Timestamptz(3)
  waitingStartedAt   DateTime?        @db.Timestamptz(3)
  activeStartedAt    DateTime?        @db.Timestamptz(3)
  endedAt            DateTime?        @db.Timestamptz(3)
  cancelledAt        DateTime?        @db.Timestamptz(3)
  disconnectCount    Int              @default(0)
  lastDisconnectedAt DateTime?        @db.Timestamptz(3)
  /// Non-clinical call metadata (durations, network quality).
  callMetadata       Json?
  createdAt          DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime         @updatedAt @db.Timestamptz(3)
  version            Int              @default(1)

  patient      Patient         @relation(fields: [organizationId, patientId], references: [organizationId, id])
  appointment  Appointment?    @relation(fields: [organizationId, patientId, appointmentId], references: [organizationId, patientId, id], onDelete: Restrict)
  consultation Consultation?   @relation(fields: [organizationId, patientId, consultationId], references: [organizationId, patientId, id], onDelete: Restrict)
  host         ProviderProfile @relation(fields: [organizationId, hostUserId], references: [organizationId, userId])

  @@unique([organizationId, patientId, appointmentId])
  @@index([organizationId, scheduledStartAt])
}

