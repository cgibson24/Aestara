// =============================================================================
// Aesthetic Platform - DRAFT relational schema
// Companion to docs/TECHNICAL_SPECIFICATION.md (section 5)
//
// Source of truth : Software Production Bible v1.0, section 19 (Canonical Data Model)
// Status          : DRAFT for Layer 0 review. This file is NOT a migration.
//                   Tables move into packages/database layer by layer (spec §5.8).
// Companion SQL   : docs/technical-spec/constraints.sql (constraints Prisma
//                   cannot express: partial uniques, CHECKs, append-only triggers).
//
// Conventions (see spec section 5.1):
//   - Primary keys are UUIDv7 (time-ordered) stored as native uuid.
//   - Every tenant-owned table carries organizationId.
//   - Child rows reference parents through COMPOSITE foreign keys that include
//     organizationId (and patientId where the Bible requires same-patient
//     guarantees) so the database itself rejects cross-tenant links.
//   - Lifecycle objects use explicit status enums (Bible Appendix A).
//   - Json columns hold intentionally flexible metadata only (Bible 19.1).
//   - Concurrently editable records carry `version` (drives ETag / If-Match).
// =============================================================================

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// 1. IDENTITY & TENANCY
//    Bible entities: User, Organization, Practice, Location, Membership, Role,
//    Permission, RolePermission, UserRole, Device, Session
//    Additions: UserCredential (first-party identity, D-02),
//               UserToken (invitation, reset and sign-in step tokens, ADR-0018)
// =============================================================================

enum UserKind {
  WORKFORCE
  PATIENT
}

enum UserStatus {
  INVITED
  ACTIVE
  LOCKED
  DISABLED
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  OFFBOARDED
}

enum OperationalStatus {
  ACTIVE
  INACTIVE
}

enum MembershipStatus {
  INVITED
  ACTIVE
  DISABLED
}

enum RoleAssignmentScope {
  PLATFORM
  ORGANIZATION
  PRACTICE
  LOCATION
}

enum ClientApp {
  IOS_PROVIDER
  IOS_PATIENT
  ADMIN_WEB
}

enum CredentialType {
  PASSWORD
  TOTP
  WEBAUTHN
}

enum SessionRevokedReason {
  LOGOUT
  ADMIN_REVOKED
  DEVICE_REVOKED
  REFRESH_TOKEN_REUSE
  CREDENTIAL_CHANGED
  MEMBERSHIP_DISABLED
  USER_DISABLED
}

enum LoginEventType {
  LOGIN_SUCCESS
  LOGIN_FAILURE
  LOGOUT
  /// Password accepted, second factor pending: a step, not a failure
  /// (ADR-0018 K-15). The API answers 401 MFA_REQUIRED with a challenge.
  MFA_CHALLENGE_ISSUED
}

enum LoginFailureReason {
  INVALID_CREDENTIALS
  ACCOUNT_LOCKED
  ACCOUNT_DISABLED
  NO_ACTIVE_MEMBERSHIP
  MFA_FAILED
  RATE_LIMITED
}

/// Platform-level identity. NOT tenant-owned: one workforce user may hold
/// memberships in several organizations. Tenant access always flows through
/// Membership + UserRole (staff) or PatientUserLink (patients), never User alone.
model User {
  id                 String     @id @default(uuid(7)) @db.Uuid
  kind               UserKind
  /// Stored normalized (trimmed, lower-cased). Unique per kind.
  email              String
  emailVerifiedAt    DateTime?  @db.Timestamptz(3)
  phone              String?
  displayName        String?
  status             UserStatus @default(INVITED)
  /// Reserved for future enterprise SSO federation (identity is first-party, D-02).
  externalIdpSubject String?    @unique
  lastLoginAt        DateTime?  @db.Timestamptz(3)
  createdAt          DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime   @updatedAt @db.Timestamptz(3)
  version            Int        @default(1)

  // --- back-relations (required by Prisma; not columns) ---
  memberships                 Membership[]            @relation("MembershipUser")
  membershipsDisabled         Membership[]            @relation("MembershipDisabledBy")
  roleAssignments             UserRole[]              @relation("UserRoleUser")
  roleAssignmentsGranted      UserRole[]              @relation("UserRoleAssignedBy")
  roleAssignmentsRevoked      UserRole[]              @relation("UserRoleRevokedBy")
  credentials                 UserCredential[]
  devices                     Device[]                @relation("DeviceUser")
  devicesRevoked              Device[]                @relation("DeviceRevokedBy")
  sessions                    Session[]               @relation("SessionUser")
  sessionsRevoked             Session[]               @relation("SessionRevokedBy")
  loginEvents                 LoginEvent[]
  tokens                      UserToken[]             @relation("UserTokenUser")
  tokensCreated               UserToken[]             @relation("UserTokenCreatedBy")
  patientsCreated             Patient[]               @relation("PatientCreatedBy")
  patientsUpdated             Patient[]               @relation("PatientUpdatedBy")
  patientsArchived            Patient[]               @relation("PatientArchivedBy")
  patientContactsCreated      PatientContact[]
  medicalHistoryRecorded      PatientMedicalHistory[]
  concernsRecorded            PatientConcern[]
  appointmentsCreated         Appointment[]
  consultationsCreated        Consultation[]          @relation("ConsultationCreatedBy")
  consultationsCompleted      Consultation[]          @relation("ConsultationCompletedBy")
  consultationsCancelled      Consultation[]          @relation("ConsultationCancelledBy")
  consultationReleaseDecisions Consultation[]         @relation("ConsultationReleaseDecidedBy")
  consultationNotes           ConsultationNote[]
  proceduresCreated           Procedure[]
  treatmentPlansCreated       TreatmentPlan[]
  protocolsCreated            PhotographyProtocol[]
  photoSessionsCaptured       PhotoSession[]
  photosCaptured              PatientPhoto[]          @relation("PhotoCapturedBy")
  photosReviewed              PatientPhoto[]          @relation("PhotoReviewedBy")
  derivativesCreated          PhotoDerivative[]
  annotations                 PhotoAnnotation[]
  photoTags                   PhotoTag[]
  photoPermissionsRecorded    PhotoPermission[]
  mediaReleasesReleased       MediaRelease[]          @relation("MediaReleaseReleasedBy")
  mediaReleasesRevoked        MediaRelease[]          @relation("MediaReleaseRevokedBy")
  beforeAfterSets             BeforeAfterSet[]
  photoRequests               PhotoRequest[]
  storageObjectsUploaded      StorageObject[]
  aiModelVersionsRegistered   AIModelVersion[]
  aiModelRolloutsChanged      AIModelRollout[]
  aiJobsRequested             AIJob[]
  simulationsCreated          Simulation[]            @relation("SimulationCreatedBy")
  simulationsReleased         Simulation[]            @relation("SimulationReleasedBy")
  simulationVersionsGenerated SimulationVersion[]
  similarCasesShown           SimilarCaseMatch[]
  caseLibraryEntriesAdded     CaseLibraryEntry[]
  outcomeMeasurements         OutcomeMeasurement[]
  consentTemplatesCreated     ConsentTemplate[]
  consentVersionsCreated      ConsentTemplateVersion[] @relation("ConsentVersionCreatedBy")
  consentVersionsPublished    ConsentTemplateVersion[] @relation("ConsentVersionPublishedBy")
  consentsAssigned            ConsentAssignment[]     @relation("ConsentAssignedBy")
  consentsVoided              ConsentAssignment[]     @relation("ConsentVoidedBy")
  consentSignatures           ConsentSignature[]
  documentsCreated            Document[]              @relation("DocumentCreatedBy")
  documentsReleased           Document[]              @relation("DocumentReleasedBy")
  documentVersionsCreated     DocumentVersion[]
  educationContentCreated     EducationContent[]
  educationVersionsPublished  EducationContentVersion[]
  contentAssigned             ContentAssignment[]
  instructionsAssigned        PatientInstruction[]    @relation("InstructionAssignedBy")
  instructionsCompleted       PatientInstruction[]    @relation("InstructionCompletedBy")
  threadsCreated              MessageThread[]
  threadParticipations        ThreadParticipant[]
  messagesSent                Message[]
  notifications               Notification[]
  syncEventsRequested         EMRSyncEvent[]
  deadLettersResolved         IntegrationDeadLetter[]
  estimatesCreated            Estimate[]              @relation("EstimateCreatedBy")
  estimatesIssued             Estimate[]              @relation("EstimateIssuedBy")
  quotesCreated               Quote[]
  featureFlagsUpdated         FeatureFlag[]
  practiceSettingsUpdated     PracticeSetting[]
  organizationSettingsUpdated OrganizationSetting[]
  retentionPoliciesCreated    RetentionPolicy[]
  dataExportsRequested        DataExportJob[]
  patientLinks                PatientUserLink[]       @relation("PatientLinkUser")
  patientLinksInvited         PatientUserLink[]       @relation("PatientLinkInvitedBy")
  patientLinksRevoked         PatientUserLink[]       @relation("PatientLinkRevokedBy")

  @@unique([kind, email])
}

/// First-party credentials (D-02). Secrets are never stored in plaintext.
model UserCredential {
  id                   String         @id @default(uuid(7)) @db.Uuid
  userId               String         @db.Uuid
  type                 CredentialType
  /// Argon2id PHC string (PASSWORD only).
  passwordHash         String?
  /// KMS envelope-encrypted TOTP seed (TOTP only).
  totpSecretCiphertext Bytes?
  webauthnCredentialId Bytes?         @unique
  webauthnPublicKey    Bytes?
  webauthnSignCount    BigInt?
  label                String?
  createdAt            DateTime       @default(now()) @db.Timestamptz(3)
  /// A TOTP or passkey counts as a second factor only once confirmed (a valid
  /// code or a verified registration); passwords are confirmed on creation (ADR-0021).
  confirmedAt          DateTime?      @db.Timestamptz(3)
  /// TOTP: the start of the last accepted time step, so a code is used only once.
  lastUsedAt           DateTime?      @db.Timestamptz(3)
  revokedAt            DateTime?      @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id])

  @@index([userId, type])
}

enum UserTokenPurpose {
  /// Staff invitation sent by email; activates a membership (organizationId set).
  INVITATION
  /// Password reset sent by email; single use, 30 minutes (ADR-0018 K-15).
  PASSWORD_RESET
  /// Pending second factor after an accepted password (MFA_CHALLENGE_ISSUED).
  MFA_CHALLENGE
  /// Pending passkey registration for an authenticated user.
  WEBAUTHN_REGISTRATION
}

/// Single-use secret for an emailed link or a sign-in step (ADR-0018 K-09,
/// K-15). Only a SHA-256 hash of the random token is stored; the token itself
/// travels in request bodies only, never in a URL, log or audit record.
model UserToken {
  id                String           @id @default(uuid(7)) @db.Uuid
  userId            String           @db.Uuid
  purpose           UserTokenPurpose
  /// Hex SHA-256 of the 256-bit random token.
  tokenHash         String           @unique
  /// INVITATION: the organization whose membership the token activates.
  organizationId    String?          @db.Uuid
  /// MFA_CHALLENGE: the client the resulting session is issued to.
  clientApp         ClientApp?
  /// WebAuthn challenge bytes (passkey assertion or registration).
  webauthnChallenge Bytes?
  /// Failed verification attempts; the token is consumed at the limit.
  attemptCount      Int              @default(0)
  createdById       String?          @db.Uuid
  createdAt         DateTime         @default(now()) @db.Timestamptz(3)
  expiresAt         DateTime         @db.Timestamptz(3)
  consumedAt        DateTime?        @db.Timestamptz(3)

  user         User          @relation("UserTokenUser", fields: [userId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy    User?         @relation("UserTokenCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([userId, purpose])
  @@index([expiresAt])
}

model Organization {
  id        String             @id @default(uuid(7)) @db.Uuid
  name      String
  /// URL-safe identifier used by admin tooling; never proof of entitlement.
  slug      String             @unique
  status    OrganizationStatus @default(ACTIVE)
  createdAt DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt DateTime           @updatedAt @db.Timestamptz(3)
  version   Int                @default(1)

  practices            Practice[]
  memberships          Membership[]
  roles                Role[]
  sessions             Session[]
  loginEvents          LoginEvent[]
  userTokens           UserToken[]
  patients             Patient[]
  appointmentTypes     AppointmentType[]
  treatmentCategories  TreatmentCategory[]
  photographyProtocols PhotographyProtocol[]
  storageObjects       StorageObject[]
  aiModelRollouts      AIModelRollout[]
  aiJobs               AIJob[]
  consentTemplates     ConsentTemplate[]
  educationContent     EducationContent[]
  notifications        Notification[]
  integrations         Integration[]
  featureFlags         FeatureFlag[]
  organizationSettings OrganizationSetting[]
  retentionPolicies    RetentionPolicy[]
  dataExportJobs       DataExportJob[]
}

model Practice {
  id             String            @id @default(uuid(7)) @db.Uuid
  organizationId String            @db.Uuid
  name           String
  /// IANA time zone, e.g. America/New_York.
  timezone       String
  status         OperationalStatus @default(ACTIVE)
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @db.Timestamptz(3)
  version        Int               @default(1)

  organization     Organization      @relation(fields: [organizationId], references: [id])
  locations        Location[]
  roleAssignments  UserRole[]
  patients         Patient[]
  appointmentTypes AppointmentType[]
  appointments     Appointment[]
  consultations    Consultation[]
  procedures       Procedure[]
  treatmentPlans   TreatmentPlan[]
  protocols        PhotographyProtocol[]
  consentTemplates ConsentTemplate[]
  messageThreads   MessageThread[]
  integrations     Integration[]
  featureFlags     FeatureFlag[]
  settings         PracticeSetting[]
  photoSessions    PhotoSession[]
  caseLibrary      CaseLibraryEntry[]

  @@unique([organizationId, id])
  @@unique([organizationId, name])
}

model Location {
  id             String            @id @default(uuid(7)) @db.Uuid
  organizationId String            @db.Uuid
  practiceId     String            @db.Uuid
  name           String
  timezone       String
  addressLine1   String?
  addressLine2   String?
  city           String?
  region         String?
  postalCode     String?
  countryCode    String?           @db.Char(2)
  status         OperationalStatus @default(ACTIVE)
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @db.Timestamptz(3)
  version        Int               @default(1)

  practice        Practice       @relation(fields: [organizationId, practiceId], references: [organizationId, id])
  roleAssignments UserRole[]
  appointments    Appointment[]
  consultations   Consultation[]
  procedures      Procedure[]
  photoSessions   PhotoSession[]

  @@unique([organizationId, id])
  @@unique([organizationId, practiceId, id])
  @@index([organizationId, practiceId])
}

/// A workforce user's membership in one organization. user.disable acts here
/// (per-organization), not on the platform-level User.
model Membership {
  id             String           @id @default(uuid(7)) @db.Uuid
  organizationId String           @db.Uuid
  userId         String           @db.Uuid
  status         MembershipStatus @default(INVITED)
  invitedAt      DateTime?        @db.Timestamptz(3)
  activatedAt    DateTime?        @db.Timestamptz(3)
  disabledAt     DateTime?        @db.Timestamptz(3)
  disabledById   String?          @db.Uuid
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(3)
  version        Int              @default(1)

  organization    Organization     @relation(fields: [organizationId], references: [id])
  user            User             @relation("MembershipUser", fields: [userId], references: [id])
  disabledBy      User?            @relation("MembershipDisabledBy", fields: [disabledById], references: [id], onDelete: Restrict)
  roleAssignments UserRole[]
  providerProfile ProviderProfile?
  staffProfile    StaffProfile?

  @@unique([organizationId, userId])
  @@index([userId])
}

/// organizationId NULL = platform-defined system role (the Bible 3.2 roles).
/// Non-null = organization custom role (creation of custom roles is UD-07).
model Role {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String?  @db.Uuid
  /// Stable machine key, e.g. SURGEON_PHYSICIAN, FRONT_DESK.
  key            String
  name           String
  description    String?
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  organization Organization?    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  permissions  RolePermission[]
  assignments  UserRole[]

  @@unique([organizationId, key])
}

/// Platform catalog of permission keys (Bible 3.3). Not tenant-owned.
model Permission {
  id          String   @id @default(uuid(7)) @db.Uuid
  /// e.g. patient.read, simulation.approve
  key         String   @unique
  description String
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  roles RolePermission[]
}

model RolePermission {
  roleId       String   @db.Uuid
  permissionId String   @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
}

/// Role assignment with explicit scope. PLATFORM scope has no organization
/// (SUPER_ADMIN); all other scopes require an active Membership in that
/// organization, enforced by the composite FK to Membership.
model UserRole {
  id             String              @id @default(uuid(7)) @db.Uuid
  userId         String              @db.Uuid
  organizationId String?             @db.Uuid
  roleId         String              @db.Uuid
  scope          RoleAssignmentScope
  practiceId     String?             @db.Uuid
  locationId     String?             @db.Uuid
  assignedById   String?             @db.Uuid
  assignedAt     DateTime            @default(now()) @db.Timestamptz(3)
  revokedAt      DateTime?           @db.Timestamptz(3)
  revokedById    String?             @db.Uuid

  user       User        @relation("UserRoleUser", fields: [userId], references: [id])
  membership Membership? @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Restrict)
  role       Role        @relation(fields: [roleId], references: [id])
  practice   Practice?   @relation(fields: [organizationId, practiceId], references: [organizationId, id], onDelete: Restrict)
  location   Location?   @relation(fields: [organizationId, practiceId, locationId], references: [organizationId, practiceId, id], onDelete: Restrict)
  assignedBy User?       @relation("UserRoleAssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)
  revokedBy  User?       @relation("UserRoleRevokedBy", fields: [revokedById], references: [id], onDelete: Restrict)

  @@index([userId, organizationId])
  @@index([organizationId, roleId])
}

model Device {
  id                 String    @id @default(uuid(7)) @db.Uuid
  userId             String    @db.Uuid
  clientApp          ClientApp
  /// Hash of the per-install identifier; the raw identifier is never stored.
  installationIdHash String
  name               String?
  model              String?
  osVersion          String?
  appVersion         String?
  apnsToken          String?
  apnsTokenUpdatedAt DateTime? @db.Timestamptz(3)
  lastSeenAt         DateTime? @db.Timestamptz(3)
  revokedAt          DateTime? @db.Timestamptz(3)
  revokedById        String?   @db.Uuid
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @db.Timestamptz(3)

  user              User               @relation("DeviceUser", fields: [userId], references: [id])
  revokedBy         User?              @relation("DeviceRevokedBy", fields: [revokedById], references: [id], onDelete: Restrict)
  sessions          Session[]
  consentSignatures ConsentSignature[]

  @@unique([userId, installationIdHash])
}

/// Server-side session enabling revocation (Bible 21.1). Refresh tokens rotate
/// on every use; a presented token whose generation is behind
/// refreshGeneration is treated as reuse and revokes the session.
model Session {
  id                String                @id @default(uuid(7)) @db.Uuid
  userId            String                @db.Uuid
  /// Active tenant context bound into issued access tokens.
  organizationId    String?               @db.Uuid
  deviceId          String?               @db.Uuid
  clientApp         ClientApp
  refreshTokenHash  String                @unique
  refreshGeneration Int                   @default(0)
  mfaVerifiedAt     DateTime?             @db.Timestamptz(3)
  ipAddress         String?               @db.Inet
  userAgent         String?
  createdAt         DateTime              @default(now()) @db.Timestamptz(3)
  lastUsedAt        DateTime?             @db.Timestamptz(3)
  idleExpiresAt     DateTime              @db.Timestamptz(3)
  absoluteExpiresAt DateTime              @db.Timestamptz(3)
  revokedAt         DateTime?             @db.Timestamptz(3)
  revokedById       String?               @db.Uuid
  revokedReason     SessionRevokedReason?

  user         User          @relation("SessionUser", fields: [userId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  device       Device?       @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  revokedBy    User?         @relation("SessionRevokedBy", fields: [revokedById], references: [id], onDelete: Restrict)

  @@index([userId, revokedAt])
  @@index([deviceId])
}

/// Security record of authentication activity. The submitted identifier is
/// stored only as a keyed hash so brute-force patterns can be correlated
/// without retaining arbitrary typed input.
model LoginEvent {
  id             String              @id @default(uuid(7)) @db.Uuid
  eventType      LoginEventType
  userId         String?             @db.Uuid
  organizationId String?             @db.Uuid
  clientApp      ClientApp?
  failureReason  LoginFailureReason?
  identifierHash String?
  sessionId      String?             @db.Uuid
  deviceId       String?             @db.Uuid
  ipAddress      String?             @db.Inet
  userAgent      String?
  requestId      String
  occurredAt     DateTime            @default(now()) @db.Timestamptz(3)

  user         User?         @relation(fields: [userId], references: [id], onDelete: Restrict)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([userId, occurredAt])
  @@index([identifierHash, occurredAt])
  @@index([occurredAt])
}

// =============================================================================
// 2. PROVIDER & PATIENT
//    Bible entities: ProviderProfile, StaffProfile, Patient, PatientContact,
//    PatientMedicalHistory, PatientConcern
//    Additions: PatientUserLink (patient-app account link, Layer 5)
// =============================================================================

enum PatientStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
  DECEASED
}

enum PatientContactKind {
  EMERGENCY_CONTACT
  GUARDIAN
  CAREGIVER
  OTHER
}

enum MedicalHistoryCategory {
  ALLERGY
  MEDICATION
  CONDITION
  PRIOR_PROCEDURE
  PRIOR_AESTHETIC_TREATMENT
  OTHER
}

enum RecordSource {
  STAFF
  PATIENT_INTAKE
  INTEGRATION
}

enum PatientLinkStatus {
  INVITED
  ACTIVE
  REVOKED
}

/// Clinical/provider identity inside one organization. Every "provider" field
/// elsewhere references (organizationId, userId) here, so a provider from
/// another tenant can never be attached to a record.
model ProviderProfile {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @db.Uuid
  userId         String   @db.Uuid
  displayName    String
  /// e.g. "MD, FACS"
  credentials    String?
  specialty      String?
  /// US National Provider Identifier (United States only, D-06).
  npi            String?  @db.Char(10)
  bio            String?
  isBookable     Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)
  version        Int      @default(1)

  membership          Membership          @relation(fields: [organizationId, userId], references: [organizationId, userId])
  appointments        Appointment[]
  consultations       Consultation[]
  procedures          Procedure[]
  treatmentPlans      TreatmentPlan[]
  treatmentPlanItems  TreatmentPlanItem[]
  telehealthSessions  TelehealthSession[]
  simulationReviews   SimulationApproval[]

  @@unique([organizationId, userId])
}

model StaffProfile {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @db.Uuid
  userId         String   @db.Uuid
  displayName    String
  jobTitle       String?
  department     String?
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)
  version        Int      @default(1)

  membership Membership @relation(fields: [organizationId, userId], references: [organizationId, userId])

  @@unique([organizationId, userId])
}

/// Bible 4.2 minimum patient entity. organizationId is always server-assigned.
model Patient {
  id                    String        @id @default(uuid(7)) @db.Uuid
  organizationId        String        @db.Uuid
  /// Optional or required per deployment policy (OrganizationSetting).
  primaryPracticeId     String?       @db.Uuid
  firstName             String
  middleName            String?
  lastName              String
  preferredName         String?
  dateOfBirth           DateTime      @db.Date
  email                 String?
  phone                 String?
  /// Search keys (ADR-0020), maintained by a database trigger from the name,
  /// email and phone columns; the application never writes them. Name keys are
  /// lower-case, accent-free and alphanumeric only; emailKey is the trimmed,
  /// lower-cased address; phoneKey holds the digits only.
  firstNameKey          String        @default("")
  lastNameKey           String        @default("")
  preferredNameKey      String?
  emailKey              String?
  phoneKey              String?
  /// Internal or externally mapped identifier; unique within the organization.
  mrn                   String?
  externalEmrIdentifier String?
  status                PatientStatus @default(ACTIVE)
  archivedAt            DateTime?     @db.Timestamptz(3)
  archivedById          String?       @db.Uuid
  createdAt             DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime      @updatedAt @db.Timestamptz(3)
  /// NULL only when created by an integration/system actor.
  createdById           String?       @db.Uuid
  updatedById           String?       @db.Uuid
  version               Int           @default(1)

  organization     Organization @relation(fields: [organizationId], references: [id])
  primaryPractice  Practice?    @relation(fields: [organizationId, primaryPracticeId], references: [organizationId, id], onDelete: Restrict)
  createdBy        User?        @relation("PatientCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy        User?        @relation("PatientUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  archivedBy       User?        @relation("PatientArchivedBy", fields: [archivedById], references: [id], onDelete: Restrict)

  contacts           PatientContact[]
  medicalHistory     PatientMedicalHistory[]
  concerns           PatientConcern[]
  userLinks          PatientUserLink[]
  appointments       Appointment[]
  consultations      Consultation[]
  procedures         Procedure[]
  treatmentPlans     TreatmentPlan[]
  photoSessions      PhotoSession[]
  photos             PatientPhoto[]
  photoPermissions   PhotoPermission[]
  mediaReleases      MediaRelease[]
  beforeAfterSets    BeforeAfterSet[]
  photoRequests      PhotoRequest[]
  aiJobs             AIJob[]
  simulations        Simulation[]
  similarCaseQueries SimilarCaseMatch[]
  outcomeMeasurements OutcomeMeasurement[]
  consentAssignments ConsentAssignment[]
  documents          Document[]
  contentAssignments ContentAssignment[]
  instructions       PatientInstruction[]
  messageThreads     MessageThread[]
  telehealthSessions TelehealthSession[]
  estimates          Estimate[]
  quotes             Quote[]
  invoiceReferences  InvoiceReference[]
  dataExportJobs     DataExportJob[]

  @@unique([organizationId, id])
  @@unique([organizationId, mrn])
  @@index([organizationId, lastName, firstName])
  @@index([organizationId, dateOfBirth])
  @@index([organizationId, status])
  /// Search indexes (ADR-0020): leakproof comparisons on the keys keep them usable under RLS.
  @@index([organizationId, lastNameKey])
  @@index([organizationId, firstNameKey])
  @@index([organizationId, preferredNameKey])
  @@index([organizationId, emailKey])
  @@index([organizationId, phoneKey])
}

model PatientContact {
  id             String             @id @default(uuid(7)) @db.Uuid
  organizationId String             @db.Uuid
  patientId      String             @db.Uuid
  kind           PatientContactKind
  fullName       String
  relationship   String?
  phone          String?
  email          String?
  isPrimary      Boolean            @default(false)
  notes          String?
  createdById    String?            @db.Uuid
  createdAt      DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @db.Timestamptz(3)
  version        Int                @default(1)

  patient   Patient @relation(fields: [organizationId, patientId], references: [organizationId, id])
  createdBy User?   @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([organizationId, patientId])
}

model PatientMedicalHistory {
  id             String                 @id @default(uuid(7)) @db.Uuid
  organizationId String                 @db.Uuid
  patientId      String                 @db.Uuid
  category       MedicalHistoryCategory
  description    String
  /// Structured detail that varies by category (flexible metadata).
  details        Json?
  onsetDate      DateTime?              @db.Date
  resolvedAt     DateTime?              @db.Date
  source         RecordSource           @default(STAFF)
  recordedById   String?                @db.Uuid
  recordedAt     DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime               @updatedAt @db.Timestamptz(3)
  version        Int                    @default(1)

  patient    Patient @relation(fields: [organizationId, patientId], references: [organizationId, id])
  recordedBy User?   @relation(fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([organizationId, patientId, category])
}

model PatientConcern {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @db.Uuid
  patientId      String    @db.Uuid
  /// Anatomical/aesthetic area, e.g. LIPS, NOSE, ABDOMEN.
  area           String
  description    String
  recordedById   String?   @db.Uuid
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)
  resolvedAt     DateTime? @db.Timestamptz(3)

  patient       Patient               @relation(fields: [organizationId, patientId], references: [organizationId, id])
  recordedBy    User?                 @relation(fields: [recordedById], references: [id], onDelete: Restrict)
  consultations ConsultationConcern[]

  @@unique([organizationId, patientId, id])
}

/// Links a PATIENT-kind User to exactly one Patient record in one organization
/// (patient-app access, Layer 5). One login may link to several organizations,
/// but data never crosses organizations (UD-08 baseline).
model PatientUserLink {
  id             String            @id @default(uuid(7)) @db.Uuid
  organizationId String            @db.Uuid
  patientId      String            @db.Uuid
  userId         String            @db.Uuid
  status         PatientLinkStatus @default(INVITED)
  invitedById    String            @db.Uuid
  invitedAt      DateTime          @default(now()) @db.Timestamptz(3)
  activatedAt    DateTime?         @db.Timestamptz(3)
  revokedAt      DateTime?         @db.Timestamptz(3)
  revokedById    String?           @db.Uuid
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @db.Timestamptz(3)

  patient   Patient @relation(fields: [organizationId, patientId], references: [organizationId, id])
  user      User    @relation("PatientLinkUser", fields: [userId], references: [id])
  invitedBy User    @relation("PatientLinkInvitedBy", fields: [invitedById], references: [id])
  revokedBy User?   @relation("PatientLinkRevokedBy", fields: [revokedById], references: [id], onDelete: Restrict)

  @@unique([organizationId, patientId, userId])
  @@index([userId])
}

// =============================================================================
// 3. SCHEDULING & CONSULTATION
//    Bible entities: Appointment, Consultation, ConsultationNote, Procedure,
//    Treatment, TreatmentCategory, TreatmentPlan, TreatmentPlanItem
//    Additions: AppointmentType, ConsultationConcern
// =============================================================================

enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentSource {
  LOCAL
  PATIENT_APP
  INTEGRATION
}

enum ConsultationStatus {
  DRAFT
  IN_PROGRESS
  AWAITING_INFORMATION
  READY_FOR_REVIEW
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum NoteStatus {
  DRAFT
  FINAL
}

/// What a consultation released to the patient before completion (spec 5.4.1;
/// ADR-0026 K3-04). Layer 3 records only NOTHING_TO_RELEASE; Layer 5's
/// consultation release records MATERIALS_RELEASED.
enum ConsultationReleaseDecision {
  NOTHING_TO_RELEASE
  MATERIALS_RELEASED
}

enum ProcedureStatus {
  PLANNED
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum TreatmentPlanStatus {
  DRAFT
  PROPOSED
  SENT_TO_PATIENT
  VIEWED
  ACCEPTED
  DECLINED
  EXPIRED
  SCHEDULED
  COMPLETED
  CANCELLED
}

model AppointmentType {
  id                     String            @id @default(uuid(7)) @db.Uuid
  organizationId         String            @db.Uuid
  practiceId             String?           @db.Uuid
  name                   String
  defaultDurationMinutes Int
  isTelehealth           Boolean           @default(false)
  status                 OperationalStatus @default(ACTIVE)
  createdAt              DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime          @updatedAt @db.Timestamptz(3)

  organization Organization  @relation(fields: [organizationId], references: [id])
  practice     Practice?     @relation(fields: [organizationId, practiceId], references: [organizationId, id], onDelete: Restrict)
  appointments Appointment[]

  @@unique([organizationId, id])
}

model Appointment {
  id                     String            @id @default(uuid(7)) @db.Uuid
  organizationId         String            @db.Uuid
  patientId              String            @db.Uuid
  practiceId             String            @db.Uuid
  locationId             String?           @db.Uuid
  providerUserId         String?           @db.Uuid
  appointmentTypeId      String?           @db.Uuid
  startsAt               DateTime          @db.Timestamptz(3)
  endsAt                 DateTime          @db.Timestamptz(3)
  /// IANA zone the appointment was booked in (display + DST-safe recurrence).
  timezone               String
  status                 AppointmentStatus @default(REQUESTED)
  reason                 String?
  consultationId         String?           @db.Uuid
  procedureId            String?           @db.Uuid
  sourceSystem           AppointmentSource @default(LOCAL)
  integrationId          String?           @db.Uuid
  externalId             String?
  externalVersion        String?
  lastSyncedAt           DateTime?         @db.Timestamptz(3)
  /// Set when inbound data conflicts with local edits; conflicts are surfaced,
  /// never silently overwritten (Bible 15.3).
  syncConflictDetectedAt DateTime?         @db.Timestamptz(3)
  cancelledAt            DateTime?         @db.Timestamptz(3)
  cancellationReason     String?
  createdById            String?           @db.Uuid
  createdAt              DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime          @updatedAt @db.Timestamptz(3)
  version                Int               @default(1)

  patient           Patient            @relation(fields: [organizationId, patientId], references: [organizationId, id])
  practice          Practice           @relation(fields: [organizationId, practiceId], references: [organizationId, id])
  location          Location?          @relation(fields: [organizationId, practiceId, locationId], references: [organizationId, practiceId, id], onDelete: Restrict)
  provider          ProviderProfile?   @relation(fields: [organizationId, providerUserId], references: [organizationId, userId], onDelete: Restrict)
  appointmentType   AppointmentType?   @relation(fields: [organizationId, appointmentTypeId], references: [organizationId, id], onDelete: Restrict)
  consultation      Consultation?      @relation(fields: [organizationId, patientId, consultationId], references: [organizationId, patientId, id], onDelete: Restrict)
  procedure         Procedure?         @relation(fields: [organizationId, patientId, procedureId], references: [organizationId, patientId, id], onDelete: Restrict)
  integration       Integration?       @relation(fields: [organizationId, integrationId], references: [organizationId, id], onDelete: Restrict)
  createdBy         User?              @relation(fields: [createdById], references: [id], onDelete: Restrict)
  telehealthSession TelehealthSession?

  @@unique([organizationId, id])
  @@unique([organizationId, patientId, id])
  @@unique([integrationId, externalId])
  @@index([organizationId, practiceId, startsAt])
  @@index([organizationId, patientId, startsAt])
  @@index([organizationId, providerUserId, startsAt])
}

model Consultation {
  id                    String             @id @default(uuid(7)) @db.Uuid
  organizationId        String             @db.Uuid
  patientId             String             @db.Uuid
  practiceId            String             @db.Uuid
  locationId            String?            @db.Uuid
  primaryProviderUserId String?            @db.Uuid
  status                ConsultationStatus @default(DRAFT)
  reason                String?
  startedAt             DateTime?          @db.Timestamptz(3)
  readyForReviewAt      DateTime?          @db.Timestamptz(3)
  completedAt           DateTime?          @db.Timestamptz(3)
  completedById         String?            @db.Uuid
  cancelledAt           DateTime?          @db.Timestamptz(3)
  cancelledById         String?            @db.Uuid
  cancellationReason    String?
  /// Required for COMPLETED (ADR-0026 K3-04); the three columns are set together.
  releaseDecision       ConsultationReleaseDecision?
  releaseDecidedAt      DateTime?          @db.Timestamptz(3)
  releaseDecidedById    String?            @db.Uuid
  archivedAt            DateTime?          @db.Timestamptz(3)
  createdById           String             @db.Uuid
  createdAt             DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime           @updatedAt @db.Timestamptz(3)
  version               Int                @default(1)

  patient         Patient          @relation(fields: [organizationId, patientId], references: [organizationId, id])
  practice        Practice         @relation(fields: [organizationId, practiceId], references: [organizationId, id])
  location        Location?        @relation(fields: [organizationId, practiceId, locationId], references: [organizationId, practiceId, id], onDelete: Restrict)
  primaryProvider ProviderProfile? @relation(fields: [organizationId, primaryProviderUserId], references: [organizationId, userId], onDelete: Restrict)
  createdBy       User             @relation("ConsultationCreatedBy", fields: [createdById], references: [id])
  completedBy     User?            @relation("ConsultationCompletedBy", fields: [completedById], references: [id], onDelete: Restrict)
  cancelledBy     User?            @relation("ConsultationCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)
  releaseDecidedBy User?           @relation("ConsultationReleaseDecidedBy", fields: [releaseDecidedById], references: [id], onDelete: Restrict)

  concerns           ConsultationConcern[]
  notes              ConsultationNote[]
  appointments       Appointment[]
  procedures         Procedure[]
  treatmentPlans     TreatmentPlan[]
  photoSessions      PhotoSession[]
  beforeAfterSets    BeforeAfterSet[]
  simulations        Simulation[]
  similarCaseMatches SimilarCaseMatch[]
  consentAssignments ConsentAssignment[]
  documents          Document[]
  contentAssignments ContentAssignment[]
  instructions       PatientInstruction[]
  telehealthSessions TelehealthSession[]

  @@unique([organizationId, id])
  @@unique([organizationId, patientId, id])
  @@index([organizationId, patientId, createdAt])
  @@index([organizationId, practiceId, status])
}

/// Concerns selected for a consultation (Bible 5.1 "Select reason / concerns").
model ConsultationConcern {
  organizationId   String   @db.Uuid
  patientId        String   @db.Uuid
  consultationId   String   @db.Uuid
  patientConcernId String   @db.Uuid
  createdAt        DateTime @default(now()) @db.Timestamptz(3)

  consultation Consultation   @relation(fields: [organizationId, patientId, consultationId], references: [organizationId, patientId, id])
  concern      PatientConcern @relation(fields: [organizationId, patientId, patientConcernId], references: [organizationId, patientId, id])

  @@id([consultationId, patientConcernId])
}

model ConsultationNote {
  /// Client-generated UUIDv7 accepted for offline-drafted notes (spec 8).
  id             String     @id @default(uuid(7)) @db.Uuid
  organizationId String     @db.Uuid
  patientId      String     @db.Uuid
  consultationId String     @db.Uuid
  authorUserId   String     @db.Uuid
  status         NoteStatus @default(DRAFT)
  body           String
  /// An addendum names the FINAL note of the same consultation it corrects (UD-15; ADR-0026 K3-07).
  correctsNoteId String?    @db.Uuid
  finalizedAt    DateTime?  @db.Timestamptz(3)
  createdAt      DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime   @updatedAt @db.Timestamptz(3)
  version        Int        @default(1)

  consultation Consultation      @relation(fields: [organizationId, patientId, consultationId], references: [organizationId, patientId, id])
  author       User              @relation(fields: [authorUserId], references: [id])
  corrects     ConsultationNote? @relation("NoteAddenda", fields: [consultationId, correctsNoteId], references: [consultationId, id], onDelete: Restrict)
  addenda      ConsultationNote[] @relation("NoteAddenda")

  @@unique([consultationId, id])
  @@index([organizationId, consultationId])
}

model TreatmentCategory {
  id             String            @id @default(uuid(7)) @db.Uuid
  organizationId String            @db.Uuid
  parentId       String?           @db.Uuid
  name           String
  sortOrder      Int               @default(0)
  status         OperationalStatus @default(ACTIVE)
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @db.Timestamptz(3)

  organization Organization        @relation(fields: [organizationId], references: [id])
  parent       TreatmentCategory?  @relation("TreatmentCategoryTree", fields: [organizationId, parentId], references: [organizationId, id], onDelete: Restrict)
  children     TreatmentCategory[] @relation("TreatmentCategoryTree")
  treatments   Treatment[]

  @@unique([organizationId, id])
}

/// Organization treatment/procedure catalog (admin module 17.1).
model Treatment {
  id                 String              @id @default(uuid(7)) @db.Uuid
  organizationId     String              @db.Uuid
  categoryId         String              @db.Uuid
  name               String
  code               String?
  description        String?
  /// Pricing unit label only (e.g. "syringe", "area"). Never an AI output.
  unitLabel          String?
  defaultUnitPrice   Decimal?            @db.Decimal(12, 2)
  /// Links catalog entries to the visualization categories of Bible 9.6.
  simulationCategory SimulationCategory?
  status             OperationalStatus   @default(ACTIVE)
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(3)

  category            TreatmentCategory   @relation(fields: [organizationId, categoryId], references: [organizationId, id])
  procedures          Procedure[]
  treatmentPlanItems  TreatmentPlanItem[]
  caseLibraryEntries  CaseLibraryEntry[]
  educationContent    EducationContent[]

  @@unique([organizationId, id])
  @@unique([organizationId, code])
}

/// A planned or performed procedure for a patient ("Procedures" tab, 4.3/13.1).
model Procedure {
  id                  String          @id @default(uuid(7)) @db.Uuid
  organizationId      String          @db.Uuid
  patientId           String          @db.Uuid
  practiceId          String          @db.Uuid
  locationId          String?         @db.Uuid
  treatmentId         String          @db.Uuid
  treatmentPlanItemId String?         @db.Uuid
  consultationId      String?         @db.Uuid
  performedByUserId   String?         @db.Uuid
  status              ProcedureStatus @default(PLANNED)
  area                String?
  scheduledFor        DateTime?       @db.Timestamptz(3)
  performedAt         DateTime?       @db.Timestamptz(3)
  notes               String?
  externalId          String?
  createdById         String?         @db.Uuid
  createdAt           DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime        @updatedAt @db.Timestamptz(3)
  version             Int             @default(1)

  patient           Patient            @relation(fields: [organizationId, patientId], references: [organizationId, id])
  practice          Practice           @relation(fields: [organizationId, practiceId], references: [organizationId, id])
  location          Location?          @relation(fields: [organizationId, practiceId, locationId], references: [organizationId, practiceId, id], onDelete: Restrict)
  treatment         Treatment          @relation(fields: [organizationId, treatmentId], references: [organizationId, id])
  treatmentPlanItem TreatmentPlanItem? @relation(fields: [organizationId, patientId, treatmentPlanItemId], references: [organizationId, patientId, id], onDelete: Restrict)
  consultation      Consultation?      @relation(fields: [organizationId, patientId, consultationId], references: [organizationId, patientId, id], onDelete: Restrict)
  performedBy       ProviderProfile?   @relation(fields: [organizationId, performedByUserId], references: [organizationId, userId], onDelete: Restrict)
  createdBy         User?              @relation(fields: [createdById], references: [id], onDelete: Restrict)

  appointments       Appointment[]
  photoSessions      PhotoSession[]
  consentAssignments ConsentAssignment[]
  contentAssignments ContentAssignment[]
  instructions       PatientInstruction[]
  invoiceReferences  InvoiceReference[]

  @@unique([organizationId, id])
  @@unique([organizationId, patientId, id])
  @@unique([organizationId, patientId, treatmentPlanItemId])
  @@index([organizationId, patientId, status])
}

/// One plan option (Plan A / B / C) for a patient. Acceptance is NOT medical
/// authorization or consent (Bible 11.1).
model TreatmentPlan {
  id                 String              @id @default(uuid(7)) @db.Uuid
  organizationId     String              @db.Uuid
  patientId          String              @db.Uuid
  consultationId     String?             @db.Uuid
  practiceId         String              @db.Uuid
  providerUserId     String?             @db.Uuid
  /// "Plan A", "Plan B", "Plan C"
  optionLabel        String?
  title              String
  status             TreatmentPlanStatus @default(DRAFT)
  /// ISO 4217
  currency           String              @default("USD") @db.Char(3)
  /// Server-computed from items; clients never submit totals.
  subtotal           Decimal             @default(0) @db.Decimal(12, 2)
  discountTotal      Decimal             @default(0) @db.Decimal(12, 2)
  estimatedTotal     Decimal             @default(0) @db.Decimal(12, 2)
  financingReference String?
  notes              String?
  proposedDate       DateTime?           @db.Date
  sentAt             DateTime?           @db.Timestamptz(3)
  viewedAt           DateTime?           @db.Timestamptz(3)
  respondedAt        DateTime?           @db.Timestamptz(3)
  expiresAt          DateTime?           @db.Timestamptz(3)
  createdById        String              @db.Uuid
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(3)
  version            Int                 @default(1)

  patient      Patient          @relation(fields: [organizationId, patientId], references: [organizationId, id])
  consultation Consultation?    @relation(fields: [organizationId, patientId, consultationId], references: [organizationId, patientId, id], onDelete: Restrict)
  practice     Practice         @relation(fields: [organizationId, practiceId], references: [organizationId, id])
  provider     ProviderProfile? @relation(fields: [organizationId, providerUserId], references: [organizationId, userId], onDelete: Restrict)
  createdBy    User             @relation(fields: [createdById], references: [id])

  items              TreatmentPlanItem[]
  estimates          Estimate[]
  consentAssignments ConsentAssignment[]
  invoiceReferences  InvoiceReference[]

  @@unique([organizationId, id])
  @@unique([organizationId, patientId, id])
  @@index([organizationId, patientId, status])
}

model TreatmentPlanItem {
  id              String    @id @default(uuid(7)) @db.Uuid
  organizationId  String    @db.Uuid
  patientId       String    @db.Uuid
  treatmentPlanId String    @db.Uuid
  treatmentId     String    @db.Uuid
  area            String?
  providerUserId  String?   @db.Uuid
  description     String?
  /// Provider-entered quantity for pricing only (Bible 11.1).
  quantity        Decimal?  @db.Decimal(10, 2)
  unitPrice       Decimal   @db.Decimal(12, 2)
  discountAmount  Decimal   @default(0) @db.Decimal(12, 2)
  lineTotal       Decimal   @db.Decimal(12, 2)
  notes           String?
  proposedDate    DateTime? @db.Date
  sortOrder       Int       @default(0)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)

  treatmentPlan TreatmentPlan    @relation(fields: [organizationId, patientId, treatmentPlanId], references: [organizationId, patientId, id])
  treatment     Treatment        @relation(fields: [organizationId, treatmentId], references: [organizationId, id])
  provider      ProviderProfile? @relation(fields: [organizationId, providerUserId], references: [organizationId, userId], onDelete: Restrict)
  procedure     Procedure?

  @@unique([organizationId, patientId, id])
  @@index([treatmentPlanId])
}

