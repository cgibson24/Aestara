model Integration {
  id             String                  @id @default(uuid(7)) @db.Uuid
  organizationId String                  @db.Uuid
  practiceId     String?                 @db.Uuid
  kind           IntegrationKind
  /// Adapter implementation key, e.g. fhir-r4, vendor-a.
  adapterKey     String
  name           String
  status         IntegrationStatus       @default(DISABLED)
  /// Non-secret adapter settings only.
  config         Json
  /// Secrets Manager reference; secret material is never stored here.
  secretRef      String?
  /// Resources for which the external system is the system of record.
  systemOfRecord CanonicalResourceType[]
  createdById    String?                 @db.Uuid
  createdAt      DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime                @updatedAt @db.Timestamptz(3)
  version        Int                     @default(1)

  organization Organization         @relation(fields: [organizationId], references: [id])
  practice     Practice?            @relation(fields: [organizationId, practiceId], references: [organizationId, id], onDelete: Restrict)
  mappings     IntegrationMapping[]
  syncEvents   EMRSyncEvent[]
  appointments Appointment[]

  @@unique([organizationId, id])
}

model IntegrationMapping {
  id              String                @id @default(uuid(7)) @db.Uuid
  organizationId  String                @db.Uuid
  integrationId   String                @db.Uuid
  resourceType    CanonicalResourceType
  localId         String                @db.Uuid
  externalId      String
  externalVersion String?
  /// Field-level provenance for mapped data (Bible 18.4).
  fieldProvenance Json?
  conflictState   MappingConflictState  @default(NONE)
  lastSyncedAt    DateTime?             @db.Timestamptz(3)
  createdAt       DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime              @updatedAt @db.Timestamptz(3)

  integration Integration @relation(fields: [organizationId, integrationId], references: [organizationId, id])

  @@unique([integrationId, resourceType, externalId])
  @@unique([integrationId, resourceType, localId])
}

model EMRSyncEvent {
  id               String                 @id @default(uuid(7)) @db.Uuid
  organizationId   String                 @db.Uuid
  integrationId    String                 @db.Uuid
  direction        SyncDirection
  resourceType     CanonicalResourceType?
  trigger          SyncTrigger
  status           SyncStatus             @default(PENDING)
  attempt          Int                    @default(1)
  retryOfId        String?                @db.Uuid
  idempotencyKey   String?
  requestedById    String?                @db.Uuid
  startedAt        DateTime?              @db.Timestamptz(3)
  finishedAt       DateTime?              @db.Timestamptz(3)
  nextRetryAt      DateTime?              @db.Timestamptz(3)
  recordsProcessed Int                    @default(0)
  recordsFailed    Int                    @default(0)
  /// Safe summary only; no PHI.
  errorSummary     String?
  createdAt        DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime               @updatedAt @db.Timestamptz(3)

  integration Integration             @relation(fields: [organizationId, integrationId], references: [organizationId, id])
  retryOf     EMRSyncEvent?           @relation("SyncRetryChain", fields: [organizationId, retryOfId], references: [organizationId, id], onDelete: Restrict)
  retries     EMRSyncEvent[]          @relation("SyncRetryChain")
  requestedBy User?                   @relation(fields: [requestedById], references: [id], onDelete: Restrict)
  deadLetters IntegrationDeadLetter[]

  @@unique([organizationId, id])
  @@unique([integrationId, idempotencyKey])
  @@index([integrationId, createdAt])
  @@index([status, nextRetryAt])
}

/// Per-record failures preserved for replay (Bible 18.4 "no silent data loss").
/// Raw payloads may contain PHI, so they live encrypted in object storage.
model IntegrationDeadLetter {
  id              String                @id @default(uuid(7)) @db.Uuid
  organizationId  String                @db.Uuid
  syncEventId     String                @db.Uuid
  resourceType    CanonicalResourceType
  externalId      String?
  payloadObjectId String?               @db.Uuid
  errorCode       String
  status          DeadLetterStatus      @default(OPEN)
  resolvedById    String?               @db.Uuid
  createdAt       DateTime              @default(now()) @db.Timestamptz(3)
  resolvedAt      DateTime?             @db.Timestamptz(3)

  syncEvent     EMRSyncEvent   @relation(fields: [organizationId, syncEventId], references: [organizationId, id])
  payloadObject StorageObject? @relation(fields: [organizationId, payloadObjectId], references: [organizationId, id], onDelete: Restrict)
  resolvedBy    User?          @relation(fields: [resolvedById], references: [id], onDelete: Restrict)

  @@unique([organizationId, payloadObjectId])
  @@index([organizationId, status])
}

/// Append-only audit trail (Bible 22). Deliberately has NO foreign keys so it
/// can be partitioned, exported to WORM storage and outlive referenced rows.
/// UPDATE/DELETE are blocked by trigger and by database grants.
/// metadata must never embed clinical content (Bible 22.2).
model AuditEvent {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String?      @db.Uuid
  actorType      ActorType
  actorUserId    String?      @db.Uuid
  actorServiceId String?
  action         AuditAction
  outcome        AuditOutcome @default(SUCCESS)
  resourceType   String
  resourceId     String?      @db.Uuid
  /// Enables per-patient access reports; an identifier, not clinical content.
  patientId      String?      @db.Uuid
  requestId      String
  sessionId      String?      @db.Uuid
  deviceId       String?      @db.Uuid
  ipAddress      String?      @db.Inet
  userAgent      String?
  metadata       Json?
  occurredAt     DateTime     @default(now()) @db.Timestamptz(3)

  @@index([organizationId, occurredAt])
  @@index([organizationId, patientId, occurredAt])
  @@index([organizationId, resourceType, resourceId])
  @@index([actorUserId, occurredAt])
  @@index([requestId])
}

/// Transactional outbox: domain events are written in the same transaction as
/// the state change, then relayed to SQS/EventBridge. Payload = identifiers only.
model OutboxEvent {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String?   @db.Uuid
  eventType      String
  aggregateType  String
  aggregateId    String    @db.Uuid
  payload        Json
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  availableAt    DateTime  @default(now()) @db.Timestamptz(3)
  publishedAt    DateTime? @db.Timestamptz(3)
  attempts       Int       @default(0)
  lastErrorCode  String?

  @@index([publishedAt, availableAt])
}

/// Replay protection for retry-sensitive mutations (Bible 20.3). Stores the
/// outcome reference, not the response body, to avoid duplicating PHI.
model IdempotencyKey {
  id             String           @id @default(uuid(7)) @db.Uuid
  /// "user:<uuid>" or "service:<name>"
  actorKey       String
  key            String
  organizationId String?          @db.Uuid
  method         String
  routeTemplate  String
  /// SHA-256 of the canonical request; a reused key with a different hash is rejected.
  requestHash    String
  state          IdempotencyState @default(IN_PROGRESS)
  responseStatus Int?
  resourceType   String?
  resourceId     String?          @db.Uuid
  errorCode      String?
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  expiresAt      DateTime         @db.Timestamptz(3)

  @@unique([actorKey, key])
  @@index([expiresAt])
}

